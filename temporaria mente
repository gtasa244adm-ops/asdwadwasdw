local function AddButton(parent, labelText, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = CurrentTheme.Accent
    btn.Text = labelText
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.ZIndex = 13
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseButton1Click:Connect(function()
        if callback then callback() end
    end)
    return btn
end

local function AddTextInput(parent, placeholder, callback)
    local tf = Instance.new("TextBox")
    tf.Size = UDim2.new(1, 0, 0, 34)
    tf.BackgroundColor3 = CurrentTheme.Input
    tf.Text = ""
    tf.PlaceholderText = placeholder
    tf.PlaceholderColor3 = CurrentTheme.SubText
    tf.TextColor3 = CurrentTheme.Text
    tf.TextSize = 12
    tf.Font = Enum.Font.Gotham
    tf.BorderSizePixel = 0
    tf.ZIndex = 13
    tf.ClearTextOnFocus = false
    tf.Parent = parent
    Instance.new("UICorner", tf).CornerRadius = UDim.new(0, 8)
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 10)
    pad.Parent = tf

    -- Borda de foco para feedback visual
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 0
    stroke.Color = CurrentTheme.Accent
    stroke.Parent = tf

    tf.Focused:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Thickness = 2}):Play()
    end)

    -- FocusLost: dispara ao perder foco (Enter OU clicar fora)
    tf.FocusLost:Connect(function(enterPressed)
        TweenService:Create(stroke, TweenInfo.new(0.15), {Thickness = 0}):Play()
        if callback then callback(tf.Text) end
    end)

    -- Enter key explícito: garante confirmação ao apertar Enter
    tf.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
            tf:ReleaseFocus(true) -- chama FocusLost com enterPressed=true
        end
    end)

    return tf
end

local function AddLabel(parent, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 0)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = CurrentTheme.SubText
    lbl.TextSize = 11
    lbl.Font = Enum.Font.Gotham
    lbl.TextWrapped = true
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 13
    lbl.Parent = parent
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 10)
    pad.Parent = lbl
    return lbl
end

