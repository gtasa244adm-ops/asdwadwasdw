--              UTILITY FUNCTIONS
-- ═══════════════════════════════════════════════

local function WorldToScreen(pos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function GetCharacter(player)
    return player and player.Character
end

local function GetHRP(player)
    local c = GetCharacter(player)
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local c = GetCharacter(player)
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local h = GetHumanoid(player)
    return h and h.Health > 0
end

local function GetDistance(player)
    local hrp = GetHRP(player)
    local lhrp = GetHRP(LocalPlayer)
    if hrp and lhrp then
        return math.floor((hrp.Position - lhrp.Position).Magnitude)
    end
    return 0
end

local function IsEnemy(player)
    return player.Team ~= LocalPlayer.Team
end

local function IsVisible(player)
    local hrp = GetHRP(player)
    if not hrp then return false end
    local origin = Camera.CFrame.Position
    local ray = Ray.new(origin, (hrp.Position - origin).Unit * 2000)
    local hit = Workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, Workspace.Terrain})
    return hit and hit:IsDescendantOf(player.Character)
end

local function GetPlayerList(filtered)
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if filtered == "Enemies" and not IsEnemy(p) then continue end
            if filtered == "Allies" and IsEnemy(p) then continue end
            table.insert(list, p)
        end
    end
    return list
end

local function GetBonePosition(player, bone)
    local c = GetCharacter(player)
    if not c then return nil end
    local part = c:FindFirstChild(bone) or c:FindFirstChild("Head") or GetHRP(player)
    return part and part.Position
end

-- Notify helper
local function Notify(title, msg, duration)
    duration = duration or 3
    StarterGui:SetCore("SendNotification", {
        Title   = title,
        Text    = msg,
        Duration = duration,
    })
end

