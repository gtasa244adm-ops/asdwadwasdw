-- ── Pegar o melhor alvo (players + NPCs + player select) ──
local function GetAimbotTarget()
    local viewportCenter = Camera.ViewportSize / 2
    local refPoint = State.AimbotMode == "Center" and viewportCenter
        or Vector2.new(Mouse.X, Mouse.Y)

    -- Player Select: se nome definido, tenta travar só nesse alvo
    if State.AimbotPlayerSelect ~= "" then
        local selName = State.AimbotPlayerSelect:lower()
        -- Busca em players primeiro
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Name:lower() == selName then
                if IsAlive(player) then return player end
            end
        end
        -- Busca em NPCs se AimbotTargetNPC ativo
        if State.AimbotTargetNPC then
            for _, model in ipairs(Workspace:GetDescendants()) do
                if model:IsA("Model") and model.Name:lower() == selName then
                    local hum = model:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(model) then
                        return model -- retorna o model do NPC
                    end
                end
            end
        end
        -- Se não achou, aborta (não mira em outros)
        return nil
    end

    -- Multi-Target lock: mantém o alvo atual vivo
    if State.MultiTargetLock and LastLockedTarget then
        local stillAlive = false
        if type(LastLockedTarget) == "table" or LastLockedTarget:IsA("Model") then
            local hum = LastLockedTarget:FindFirstChildOfClass("Humanoid")
            stillAlive = hum and hum.Health > 0
        else
            stillAlive = IsAlive(LastLockedTarget)
        end
        if stillAlive then
            local bonePos = nil
            if Players:GetPlayerFromCharacter(LastLockedTarget) then
                local p = Players:GetPlayerFromCharacter(LastLockedTarget)
                bonePos = GetBestBone(p)
            elseif LastLockedTarget:IsA("Model") then
                bonePos = GetNPCBonePos(LastLockedTarget)
            else
                bonePos = GetBestBone(LastLockedTarget)
            end
            if bonePos then
                local sp, on = WorldToScreen(bonePos)
                if on and (sp - refPoint).Magnitude < State.AimbotFOV then
                    return LastLockedTarget
                end
            end
        else
            LastLockedTarget = nil
        end
    end

    local bestTarget = nil
    local bestDist   = math.huge

    -- ── Scan Players ──
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not IsAlive(player) then continue end
        if State.AimbotTeamCheck and not IsEnemy(player) then continue end

        local bonePos = GetBestBone(player)
        if not bonePos then continue end
        local screenPos, onScreen = WorldToScreen(bonePos)
        if not onScreen then continue end

        if State.AimbotWallCheck and not State.AutoWall then
            if not WallCheckClear(bonePos, GetCharacter(player)) then continue end
        end
        if State.AutoWall then
            if not AutoWallCheck(bonePos, GetCharacter(player)) then continue end
        end
        if State.AimbotVisible and not IsVisible(player) then continue end

        local dist = (screenPos - refPoint).Magnitude
        if dist < State.AimbotFOV and dist < bestDist then
            bestDist   = dist
            bestTarget = player
        end
    end

    -- ── Scan NPCs (se AimbotTargetNPC ativo) ──
    if State.AimbotTargetNPC then
        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= LocalPlayer.Character then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(model) then
                    local bonePos = GetNPCBonePos(model)
                    if bonePos then
                        local screenPos, onScreen = WorldToScreen(bonePos)
                        if onScreen then
                            local dist = (screenPos - refPoint).Magnitude
                            if dist < State.AimbotFOV and dist < bestDist then
                                bestDist   = dist
                                bestTarget = model -- NPC model
                            end
                        end
                    end
                end
            end
        end
    end

    if State.MultiTargetLock then
        LastLockedTarget = bestTarget
    end

    return bestTarget
end

