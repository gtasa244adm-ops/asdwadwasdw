    tf.TextXAlignment = Enum.TextXAlignment.Center
    tf.Parent = row
    Instance.new("UICorner", tf).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 0
    stroke.Color = CurrentTheme.Accent
    stroke.Parent = tf

    tf.Focused:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Thickness = 2}):Play()
        tf.Text = ""
    end)

    local function Confirm()
        TweenService:Create(stroke, TweenInfo.new(0.15), {Thickness = 0}):Play()
        local val = tonumber(tf.Text)
        if val then
            val = math.clamp(math.floor(val / step) * step, minVal, maxVal)
            State[stateKey] = val
            tf.Text = tostring(val)
        else
            tf.Text = tostring(State[stateKey])
        end
    end

    tf.FocusLost:Connect(function() Confirm() end)
    tf.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
            tf:ReleaseFocus(true)
        end
    end)
    return row
