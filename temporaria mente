            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            lbl.TextSize = 9
            lbl.Font = Enum.Font.Gotham
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 3
            lbl.Parent = dot
            MinimapDots[player] = dot
        end

        local relPos = pHRP.Position - myHRP.Position
        local dx = relPos.X / scale
        local dy = relPos.Z / scale
        local px = math.clamp(center.X + dx, 5, 155)
        local py = math.clamp(center.Y + dy, 5, 155)
        MinimapDots[player].Position = UDim2.new(0, px - 4, 0, py - 4)
        MinimapDots[player].BackgroundColor3 = IsEnemy(player)
            and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 100)
    end
end

