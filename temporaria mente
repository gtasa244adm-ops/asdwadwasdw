-- ── Triggerbot ──
local TriggerbotConn
local function SetupTriggerbot()
    if TriggerbotConn then TriggerbotConn:Disconnect() TriggerbotConn = nil end
    if not State.Triggerbot then return end

    TriggerbotConn = RunService.Heartbeat:Connect(function()
        if not State.Triggerbot then return end
        if TriggerbotFiring then return end

        local viewportCenter = Camera.ViewportSize / 2
        local refPoint = State.AimbotMode == "Center" and viewportCenter
            or Vector2.new(Mouse.X, Mouse.Y)

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not IsAlive(player) then continue end
            if State.AimbotTeamCheck and not IsEnemy(player) then continue end

            local bonePos = GetBestBone(player)
            if not bonePos then continue end

            local screenPos, onScreen = WorldToScreen(bonePos)
            if not onScreen then continue end

            local dist = (screenPos - refPoint).Magnitude
            if dist < State.AimbotFOV * 0.35 then -- 35% do FOV para triggerbot
                TriggerbotFiring = true
                -- Delay antes de atirar (slider 1-100 → 0.01s a 0.5s)
                local delay = math.clamp(State.TriggerbotDelay / 100 * 0.5, 0.01, 0.5)
                task.wait(delay)
                if State.Triggerbot then
                    mouse1click()
                end
                task.wait(0.05)
                TriggerbotFiring = false
                break
            end
        end
    end)
end

-- ── Humanização: atualiza offsets com Perlin noise suave ──
local function UpdateHumanize(dt)
    if not State.AimbotHumanize then
        HumanizeOffset = Vector2.new(0, 0)
        return
    end
    HumanizeTimer = HumanizeTimer + dt * 2
    local strength = math.clamp(State.HumanizeStrength / 100 * 12, 0.1, 12)
    -- Usa math.sin com frequências diferentes para simular movimento humano
    local nx = math.sin(HumanizeTimer * 1.3) * math.cos(HumanizeTimer * 0.7) * strength
    local ny = math.cos(HumanizeTimer * 1.1) * math.sin(HumanizeTimer * 0.9) * strength
    -- Interpola suavemente para não pular
    HumanizeOffset = HumanizeOffset:Lerp(Vector2.new(nx, ny), 0.15)
end

-- ── Main Aimbot Update ──
local function UpdateAimbot(dt)
    local viewportCenter = Camera.ViewportSize / 2
    local refPoint = State.AimbotMode == "Center" and viewportCenter
        or Vector2.new(Mouse.X, Mouse.Y)

    -- FOV Circle
    if AimbotFOVCircle then
        AimbotFOVCircle.Visible = State.Aimbot and State.AimbotShowFOV
        AimbotFOVCircle.Position = refPoint
        AimbotFOVCircle.Radius   = State.AimbotFOV
    end

    UpdateHumanize(dt or 0.016)

    if not State.Aimbot then return end

    -- Aim Key: só mira se tecla pressionada
    if State.AimbotKey and not AimKeyHeld then return end

    local target = GetAimbotTarget()
    if not target then return end

    local bonePos = GetBestBone(target)
    if not bonePos then return end

    -- Silent Aim
    if State.SilentAim then
        pcall(function() Mouse.Hit = CFrame.new(bonePos) end)
        return
    end

    -- Predição
    local predictedPos = GetPredictedPosition(target, bonePos)

    -- ── HARD LOCK: gruda direto na cabeça sem lerp ──
    if State.AimbotHardLock then
        local targetCF = CFrame.lookAt(Camera.CFrame.Position, predictedPos)
        if State.AimbotHumanize then
            targetCF = targetCF * CFrame.Angles(
                math.rad(HumanizeOffset.Y * 0.5),
                math.rad(HumanizeOffset.X * 0.5), 0)
        end
        Camera.CFrame = targetCF * AimShakeOffset
        return
    end

    -- Smooth lerp normal
    local smooth = math.clamp(State.AimbotSmooth / 100 * 0.3, 0.01, 0.3)
    local targetCF = CFrame.lookAt(Camera.CFrame.Position, predictedPos)
    if State.AimbotHumanize then
        targetCF = targetCF * CFrame.Angles(
            math.rad(HumanizeOffset.Y * 0.5),
            math.rad(HumanizeOffset.X * 0.5), 0)
    end
    Camera.CFrame = (Camera.CFrame:Lerp(targetCF, smooth)) * AimShakeOffset
end

