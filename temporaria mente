-- ── Wall Check: retorna true se NÃO tem parede entre câmera e posição ──
local function WallCheckClear(pos, character)
    local origin = Camera.CFrame.Position
    local dir = (pos - origin)
    local ray = Ray.new(origin, dir.Unit * dir.Magnitude)
    local ignoreList = {LocalPlayer.Character, Workspace.Terrain}
    local hit, _ = Workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
    if not hit then return true end
    -- Se o que acertou é parte do alvo, está visível
    return hit and character and hit:IsDescendantOf(character)
end

-- ── Auto Wall: verifica se o projétil pode penetrar ──
local function AutoWallCheck(pos, character)
    local origin = Camera.CFrame.Position
    local dir = (pos - origin)
    local ray = Ray.new(origin, dir.Unit * dir.Magnitude)
    local ignoreList = {LocalPlayer.Character, Workspace.Terrain}
    local hit, hitPos = Workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
    if not hit then return true end
    if character and hit:IsDescendantOf(character) then return true end
    -- Verifica se a parte é fina o suficiente para penetrar (espessura < 2 studs)
    if hit and hit:IsA("BasePart") then
        local size = hit.Size
        local minSize = math.min(size.X, size.Y, size.Z)
        return minSize < 2
    end
    return false
end

-- ── Head/Body Swap: retorna o melhor osso disponível (player ou NPC) ──
local function GetBestBone(target)
    -- Se for um Player
    if typeof(target) == "Instance" and target:IsA("Player") then
        if not State.HeadBodySwap then
            return GetBonePosition(target, State.AimbotBone)
        end
        local c = GetCharacter(target)
        if not c then return nil end
        local head = c:FindFirstChild("Head")
        if head and WallCheckClear(head.Position, c) then return head.Position end
        local torso = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
        if torso then return torso.Position end
        return nil
    end
    -- Se for um NPC model
    if typeof(target) == "Instance" and target:IsA("Model") then
        return GetNPCBonePos(target)
    end
    return nil
end

-- ── Aim Prediction avançada (projétil + gravidade) ──
local function GetPredictedPosition(target, bonePos)
    local tHRP = nil
    if typeof(target) == "Instance" and target:IsA("Player") then
        tHRP = GetHRP(target)
    elseif typeof(target) == "Instance" and target:IsA("Model") then
        tHRP = target:FindFirstChild("HumanoidRootPart")
    end
    if not tHRP then return bonePos end

    local vel  = tHRP.AssemblyLinearVelocity
    local dist = (Camera.CFrame.Position - bonePos).Magnitude

    if State.AimPredictionAdv then
        local projSpeed  = math.clamp(State.AimProjSpeed / 100 * 10000, 100, 10000)
        local travelTime = dist / projSpeed
        local gravity    = Vector3.new(0, -196.2, 0)
        local gravityOffset = 0.5 * gravity * (travelTime * travelTime)
        return bonePos + vel * travelTime - gravityOffset
    else
        local travelTime = dist / 1000
        return bonePos + vel * travelTime
    end
end

