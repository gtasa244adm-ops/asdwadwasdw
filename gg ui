    local scripts = {}
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("Script") or v:IsA("ModuleScript") then
            table.insert(scripts, v:GetFullName() .. " [" .. v.ClassName .. "]")
        end
    end
    table.sort(scripts)
    return scripts
end

