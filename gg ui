-- [14] FUNÇÕES ÚTEIS JÁ PRONTAS NO SCRIPT
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
--[[

  Notify(titulo, mensagem, segundos)
  → Manda notificação na tela
  → Exemplo: Notify("✅","Feito!",3)

  GetHRP(player)
  → Retorna HumanoidRootPart do player
  → Exemplo: local hrp = GetHRP(LocalPlayer)

  GetHumanoid(player)
  → Retorna Humanoid do player
  → Exemplo: local hum = GetHumanoid(LocalPlayer)

  GetCharacter(player)
  → Retorna Character do player
  → Exemplo: local char = GetCharacter(LocalPlayer)

  IsAlive(player)
  → Retorna true se o player está vivo
  → Exemplo: if IsAlive(LocalPlayer) then ... end

  IsEnemy(player)
  → Retorna true se player é inimigo (team diferente)
  → Exemplo: if IsEnemy(p) then ... end

  GetDistance(player)
  → Retorna distância em studs entre você e o player
  → Exemplo: local dist = GetDistance(p)

  WorldToScreen(posicao3D)
  → Converte posição 3D do mundo pra 2D na tela
  → Retorna: pos2D, onScreen, depth
  → Exemplo: local pos, vis = WorldToScreen(hrp.Position)

  GetPlayerList(filtro)
  → Retorna lista de players (nil=todos, "Enemies", "Allies")
  → Exemplo: for _, p in ipairs(GetPlayerList("Enemies")) do ... end

  IsVisible(player)
  → Retorna true se player está visível (sem parede na frente)
  → Exemplo: if IsVisible(p) then ... end

]]

