-- KBSave agora é chamado internamente pelo SaveSettings (tudo em um JSON)
local function KBSave()
    pcall(SaveSettings) -- salva tudo junto
end

-- KBLoadFromFile restaura os binds do save principal
_G.KBLoadFromFile = function()
    -- Binds já são restaurados dentro do LoadSettings
    -- Esta função existe para compatibilidade
    pcall(function()
        local raw = nil
        pcall(function() if readfile and isfile and isfile("GGScript_v11_keybinds.json") then raw = readfile("GGScript_v11_keybinds.json") end end)
        if not raw or raw == "" then pcall(function() raw = LocalPlayer:GetAttribute("GGKBinds_v11") end) end
        if not raw or raw == "" then return end
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok or not data then return end
        local allItems = {}
        local function scanMenu(menu, seen)
            if not menu then return end; seen = seen or {}; if seen[menu] then return end; seen[menu] = true
            for _, it in ipairs(menu.items or {}) do
                table.insert(allItems, it)
                if it.tipo == "submenu" and it.subm then scanMenu(it.subm, seen) end
            end
        end
        if MS and MS.root then scanMenu(MS.root) end
        local restored = 0
        for label, keyStr in pairs(data) do
            for _, it in ipairs(allItems) do
                if it.label == label then
                    local kc = nil; pcall(function() kc = Enum.KeyCode[keyStr] end)
                    if kc then KeyBindMap[it] = {key=kc, str=keyStr}; restored = restored + 1 end
                    break
                end
            end
        end
        if restored > 0 then Notify("🔑 Key Binds", restored.." bind(s) restaurado(s)!", 3) end
    end)
end


local function KBStart(item)
    if not item then return end
    if item.tipo=="display" or item.tipo=="submenu" then
        Notify("Key Bind","Esse item não pode ter bind",2) return
    end
    KBCaptureMode=true; KBCaptureItem=item
    Notify("🔑 Key Bind","Pressione a tecla para:\n"..item.label.."\n(ESC = cancelar)",5)
end

local function KBCancel()
    KBCaptureMode=false; KBCaptureItem=nil
    Notify("Key Bind","Cancelado",1)
end

local function KBConfirm(kc)
    if not KBCaptureItem then KBCaptureMode=false return end
    local keyStr=tostring(kc):match("KeyCode%.(.+)") or tostring(kc)
    KeyBindMap[KBCaptureItem]={key=kc, str=keyStr}
    Notify("🔑 Bind OK",KBCaptureItem.label.." → "..keyStr,3)
    KBCaptureMode=false; KBCaptureItem=nil
    KBSave()
    if MS.open then pcall(Render) end
end

local function KBExecItem(item)
    if not item then return end
    if item.tipo=="toggle" then
        item.enabled=not item.enabled
        if item.togCb then pcall(item.togCb,item.enabled) end
        if MS.open then pcall(Render) end
    elseif item.tipo=="action" and not item.isPlayerSel then
        if item.cb then pcall(item.cb) end
    end
end

local function KBRemove(item)
    KeyBindMap[item]=nil; KBSave()
    Notify("Key Bind","Bind removido",2)
    if MS.open then pcall(Render) end
end

