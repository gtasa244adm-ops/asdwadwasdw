        end

        -- ── Skeleton ──
        if State.ESP_Skeleton and obj.SkelLines and show then
            local char = player.Character
            -- Re-detecta rig se personagem mudou (respawn)
            if char then
                local nowR15 = char:FindFirstChild("UpperTorso") ~= nil
                if nowR15 ~= obj.SkelIsR15 then
                    -- Reconstrói linhas para o novo rig
                    for _,s in ipairs(obj.SkelLines) do s.line:Remove() end
                    local skelDef = nowR15 and _SKEL_R15 or _SKEL_R6
                    obj.SkelLines = {}; obj.SkelIsR15 = nowR15
                    for i=1,#skelDef do
                        local l=Drawing.new("Line"); l.Visible=false
                        l.Color=Color3.fromRGB(0,255,200); l.Thickness=1.5
                        obj.SkelLines[i]={line=l,from=skelDef[i][1],to=skelDef[i][2]}
                    end
                end
                for _,s in ipairs(obj.SkelLines) do
                    local fp=char:FindFirstChild(s.from); local tp=char:FindFirstChild(s.to)
                    if fp and tp then
                        local sp1,on1=WorldToScreen(fp.Position)
                        local sp2,on2=WorldToScreen(tp.Position)
                        if on1 and on2 then
                            s.line.Visible=true; s.line.Color=espColor
                            s.line.From=sp1; s.line.To=sp2
                        else s.line.Visible=false end
                    else s.line.Visible=false end
                end
            end
        elseif obj.SkelLines then
            for _,s in ipairs(obj.SkelLines) do s.line.Visible=false end
        end
    end -- for player
    end -- else anyESP

    -- ── NPC ESP — scan só a cada 2 segundos ──
    if State.ESP_NPC then
        _espNPCThrottle = (_espNPCThrottle or 0) + 1
        if _espNPCThrottle >= 120 then  -- a cada ~2s a 60fps
            _espNPCThrottle = 0
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("Model") and v ~= LocalPlayer.Character then
                    local nHum = v:FindFirstChildOfClass("Humanoid")
                    local nHRP = v:FindFirstChild("HumanoidRootPart")
                    if nHum and nHRP and not Players:GetPlayerFromCharacter(v) and not NPCObjects[v] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor=Color3.fromRGB(255,200,0); hl.OutlineColor=Color3.fromRGB(255,200,0)
                        hl.FillTransparency=0.7; pcall(function() hl.Adornee=v end); hl.Parent=PlayerGui
                        local bb=Instance.new("BillboardGui")
                        bb.StudsOffset=Vector3.new(0,3,0); bb.AlwaysOnTop=true
                        bb.Size=UDim2.new(0,120,0,20); bb.Adornee=nHRP; bb.Parent=PlayerGui
                        local lbl=Instance.new("TextLabel")
