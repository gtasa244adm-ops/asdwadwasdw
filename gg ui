-- Fake Lag
local function SetupFakeLag()
    Conns.FakeLagActive = State.FakeLag
    if Conns.FakeLag then Conns.FakeLag:Disconnect() Conns.FakeLag = nil end
    if not State.FakeLag then return end
    -- Usa task.spawn interno para nunca soltar a conexão enquanto State.FakeLag = true
    Conns.FakeLag = RunService.Heartbeat:Connect(function()
        if not State.FakeLag then return end
        local lagSecs = math.clamp(State.FakeLagAmount / 100, 0.01, 1.0)
        local endTime = tick() + lagSecs
        -- busy-wait real: bloqueia o thread do Heartbeat
        repeat task.wait() until tick() >= endTime or not State.FakeLag
    end)
    -- Watchdog: se a conexão morrer mas FakeLag ainda tiver ativo, recria
    task.spawn(function()
        while State.FakeLag do
            task.wait(1)
            if State.FakeLag and (not Conns.FakeLag) then
                SetupFakeLag()
                break
            end
        end
    end)
end

