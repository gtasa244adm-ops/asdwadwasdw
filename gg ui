-- ── Tool Giver ──
local function GiveTool(toolName)
    if toolName == "" then Notify("Tool Giver", "Digite um nome", 2) return end
    local found = nil
    -- Procura em todo o game (StarterPack, ReplicatedStorage, Workspace, etc)
    for _, v in ipairs(game:GetDescendants()) do
        if v:IsA("Tool") and v.Name:lower() == toolName:lower() then
            found = v
            break
        end
    end
    if found then
        local bp = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer:WaitForChild("Backpack", 3)
        if bp then
            local clone = found:Clone()
            clone.Parent = bp
            Notify("Tool Giver", "Pegou: " .. found.Name, 3)
        else
            Notify("Tool Giver", "Backpack nao encontrado", 3)
        end
    else
        Notify("Tool Giver", "Tool nao encontrada: " .. toolName, 3)
    end
end

