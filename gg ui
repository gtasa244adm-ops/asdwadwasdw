        tl.BackgroundTransparency=1; tl.Text=T
        tl.TextColor3=Color3.fromRGB(255,255,255); tl.TextSize=15
        tl.TextXAlignment=Enum.TextXAlignment.Left; tl.Font=Enum.Font.GothamBold; tl.Parent=f

        local cl=Instance.new("TextLabel")
        cl.Size=UDim2.new(1,-18,0,22); cl.Position=UDim2.new(0,14,0,37)
        cl.BackgroundTransparency=1; cl.Text=C
        cl.TextColor3=Color3.fromRGB(185,185,185); cl.TextSize=13
        cl.TextXAlignment=Enum.TextXAlignment.Left; cl.Font=Enum.Font.Gotham; cl.Parent=f

        local yPos = 50 + #activeNotifs*(NH+NG)
        f.Position = UDim2.new(1,NW+20,0,yPos)
        table.insert(activeNotifs,f)

        local function repos()
            for i,n in ipairs(activeNotifs) do
                if n and n.Parent then
                    TweenService:Create(n,TweenInfo.new(NS,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
                        {Position=UDim2.new(1,-NW-20,0,50+(i-1)*(NH+NG))}):Play()
                end
            end
        end
        TweenService:Create(f,TweenInfo.new(NS,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
            {Position=UDim2.new(1,-NW-20,0,yPos)}):Play()
        repos()

        task.wait(D)
        for i,n in ipairs(activeNotifs) do if n==f then table.remove(activeNotifs,i) break end end
        TweenService:Create(f,TweenInfo.new(NS,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),
            {Position=UDim2.new(1,NW+20,0,f.Position.Y.Offset)}):Play()
        task.wait(NS+0.05)
        if f and f.Parent then f:Destroy() end
        repos()
    end)
end

