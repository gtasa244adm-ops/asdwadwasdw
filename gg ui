    if _popItem.isText then
        local txt=PopBox.Text
        _popItem.textVal=txt
        if _popItem.textCb then pcall(_popItem.textCb,txt) end
    else
        local raw=PopBox.Text:match("^%s*(-?[%d%.]+)%s*$")
        if raw then
            local num=tonumber(raw)
            if num then
                _popItem.val=num
                if _popItem.slCb then pcall(_popItem.slCb,num) end
            end
        end
    end
    ClosePopup()
    task.defer(function() if MS.cur then pcall(function() Render() end) end end)
end

