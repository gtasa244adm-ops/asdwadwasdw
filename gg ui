            Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 3)

            local aliases = #cmd.names > 1 and ("  |  "..table.concat(cmd.names, ", ", 2)) or ""
            local nl = Instance.new("TextLabel", entry)
            nl.Size = UDim2.new(1,-14,0,20); nl.Position = UDim2.new(0,12,0,5)
            nl.BackgroundTransparency = 1; nl.Text = ";"..cmd.names[1]..aliases
            nl.TextColor3 = THEME.cmd; nl.Font = Enum.Font.GothamBold; nl.TextSize = 13
            nl.TextXAlignment = Enum.TextXAlignment.Left

            local dl = Instance.new("TextLabel", entry)
            dl.Size = UDim2.new(1,-14,0,15); dl.Position = UDim2.new(0,12,0,23)
            dl.BackgroundTransparency = 1; dl.Text = cmd.desc
            dl.TextColor3 = THEME.subtext; dl.Font = Enum.Font.Gotham; dl.TextSize = 12
            dl.TextXAlignment = Enum.TextXAlignment.Left

            local ul = Instance.new("TextLabel", entry)
            ul.Size = UDim2.new(1,-14,0,13); ul.Position = UDim2.new(0,12,0,40)
            ul.BackgroundTransparency = 1; ul.Text = cmd.usage
            ul.TextColor3 = Color3.fromRGB(80,200,80); ul.Font = Enum.Font.Code; ul.TextSize = 11
            ul.TextXAlignment = Enum.TextXAlignment.Left
        end
    end
    CmdsScroll.CanvasSize = UDim2.new(0, 0, 0, count * 60)
end

