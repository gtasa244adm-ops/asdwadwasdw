-- ── SyncAllToState: sincroniza toggle/slider UI com State após load ──
local function SyncAllToState()
    local function walk(m,seen)
        if not m or seen[m] then return end
        seen[m]=true
        for _,it in ipairs(m.items or {}) do
            if it.tipo=="toggle" and it.togCb then
                -- Dispara togCb com valor atual do it.enabled (já restaurado pelo LoadSettings)
                pcall(it.togCb, it.enabled)
            elseif it.tipo=="slider" and it.slCb then
                pcall(it.slCb, it.val)
            elseif it.isText and it.tipo=="action" and it.textCb and it.textVal then
                pcall(it.textCb, it.textVal)
            end
            if it.tipo=="submenu" and it.subm then walk(it.subm,seen) end
        end
    end
    task.defer(function()
        pcall(function()
            if MS and MS.root then walk(MS.root,{}) end
            pcall(Render)
        end)
    end)
end
_G._GGSyncToggles = SyncAllToState

