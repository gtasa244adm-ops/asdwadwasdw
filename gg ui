        end

        -- ── 2D Box ──
        local screenPos, onScreen, depth = WorldToScreen(hrp.Position)
        if State.ESP_Box2D and show and onScreen and obj.Box2D then
            local h = math.clamp(2000/depth, 20, 400)
            local w = h * 0.6
