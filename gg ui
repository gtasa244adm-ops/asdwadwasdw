local function isGivenAnim(holder, id)
    for _, a in holder:GetChildren() do
        if a:IsA("Animation") and urlToId(a.AnimationId) == id then return true end
    end
    return false
end

local function isDancing(char, track)
    local id = urlToId(track.Animation.AnimationId)
    local animate = char:FindFirstChild("Animate")
    if not animate then return true end
    for _, h in animate:GetChildren() do
        if h:IsA("StringValue") and isGivenAnim(h, id) then return false end
    end
    return true
end

-- ════════════════════════════════════════════════════════════
--  ANIMAÇÕES DE MOVIMENTO
-- ════════════════════════════════════════════════════════════
local originalMoveAnims = {}

local ANIM_MAP = {
    walk     = { slot = "walk",     idx = 1 },
    run      = { slot = "run",      idx = 1 },
    idle1    = { slot = "idle",     idx = 1 },
    idle2    = { slot = "idle",     idx = 2 },
    jump     = { slot = "jump",     idx = 1 },
    fall     = { slot = "fall",     idx = 1 },
    climb    = { slot = "climb",    idx = 1 },
    swim     = { slot = "swim",     idx = 1 },
    swimidle = { slot = "swimidle", idx = 1 },
}

local function applyMoveAnims(char)
    local animate = char:WaitForChild("Animate", 5)
    if not animate then
        Notify({ Title = "⚠️ Anims", Content = "Script Animate não encontrado.", Duration = 4 })
        return
    end

    local pack = getAnimPack()
    if not pack then return end

    for key, info in pairs(ANIM_MAP) do
        local newId = pack[key]
        local slotVal = animate:FindFirstChild(info.slot)
        if slotVal then
            local anims = {}
            for _, a in ipairs(slotVal:GetChildren()) do
                if a:IsA("Animation") then table.insert(anims, a) end
            end
            table.sort(anims, function(a, b) return a.Name < b.Name end)

            local target = anims[info.idx]
            if target then
                local origKey = info.slot .. "_" .. info.idx
                if not originalMoveAnims[origKey] then
                    originalMoveAnims[origKey] = target.AnimationId
                end
                if newId and newId ~= 0 then
                    target.AnimationId = "rbxassetid://" .. tostring(newId)
                else
                    if originalMoveAnims[origKey] then
                        target.AnimationId = originalMoveAnims[origKey]
                    end
                end
            end
        end
    end

    Notify({ Title = "🎒 " .. pack.packName, Content = "Animações aplicadas! (" .. currentAnimPackIdx .. "/" .. #ANIM_PACKS .. ")", Duration = 3 })
end

local function resetMoveAnims(char)
    local animate = char:FindFirstChild("Animate")
    if not animate then return end

    for key, info in pairs(ANIM_MAP) do
        local slotVal = animate:FindFirstChild(info.slot)
        if slotVal then
            local anims = {}
            for _, a in ipairs(slotVal:GetChildren()) do
                if a:IsA("Animation") then table.insert(anims, a) end
            end
            table.sort(anims, function(a, b) return a.Name < b.Name end)

            local target = anims[info.idx]
            local origKey = info.slot .. "_" .. info.idx
            if target and originalMoveAnims[origKey] then
                target.AnimationId = originalMoveAnims[origKey]
            end
        end
    end

    Notify({ Title = "🔄 Anims resetadas", Content = "Animações de movimento restauradas.", Duration = 3 })
end

-- ════════════════════════════════════════════════════════════
--  onCharacterAdded
-- ════════════════════════════════════════════════════════════
local function onCharacterAdded(char)
    stopCurrentEmote()
    local hum      = char:WaitForChild("Humanoid")
    local animator = hum:WaitForChild("Animator")

    if currentAnimPackIdx ~= 0 then
        task.delay(0.5, function() applyMoveAnims(char) end)
    end

    if getgenv().autoReloadEnabled and getgenv().lastPlayedEmoteId then
        task.wait(0.8)
        forcePlayEmote(getgenv().lastPlayedEmoteId)
        Notify({ Title = "🔄 Auto Reload", Content = "Último emote reaplicado.", Duration = 3 })
    end

    animator.AnimationPlayed:Connect(function(animTrack)
        if not isDancing(char, animTrack) then return end
        local emoteId = urlToId(animTrack.Animation.AnimationId)
        getgenv().lastPlayedEmoteId = emoteId

        if emotesWalkEnabled or speedEmoteEnabled then
            if currentEmoteTrack then
                if urlToId(currentEmoteTrack.Animation.AnimationId) == emoteId then return end
                stopCurrentEmote()
            end
            forcePlayEmote(tonumber(emoteId))
        end
    end)

    local walkHeartbeat
    walkHeartbeat = RunService.Heartbeat:Connect(function()
        if Player.Character ~= char then
            walkHeartbeat:Disconnect()
            return
        end

        local h = char:FindFirstChild("Humanoid")
        if not h then return end

        local isMoving = h.MoveDirection.Magnitude > 0

        if isMoving then
            if emotesWalkEnabled then
                if currentEmoteTrack then
                    if not currentEmoteTrack.IsPlaying then
                        pcall(function() currentEmoteTrack:Play() end)
                        if speedEmoteEnabled and SpeedBox then
                            pcall(function()
                                currentEmoteTrack:AdjustSpeed(tonumber(SpeedBox.Text) or 1)
                            end)
                        end
                    end
                end
            else
                if currentEmoteTrack and currentEmoteTrack.IsPlaying then
                    stopCurrentEmote()
                end
            end
        end
    end)

    hum.Died:Connect(function()
        if walkHeartbeat then
            walkHeartbeat:Disconnect()
            walkHeartbeat = nil
        end
        emotesWalkEnabled = false
        speedEmoteEnabled = false
        favoriteEnabled   = false
        currentEmoteTrack = nil
        stopAllEmotes()
        stopCurrentEmote()
        if BtnWalk and BtnWalk.Parent then BtnWalk.Image = IMG_OFF end
        if BtnFav  and BtnFav.Parent  then BtnFav.Image  = IMG_FAV_OFF end
    end)
end

