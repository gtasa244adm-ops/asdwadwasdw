    local list = GetSelectablePlayers()
    if #list == 0 then return nil end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return list[1] end
    local nearest, dist = nil, math.huge
    for _, p in ipairs(list) do
        local ch=p.Character; local hr=ch and ch:FindFirstChild("HumanoidRootPart")
        if hr then local d=(hr.Position-myRoot.Position).Magnitude
            if d<dist then dist=d; nearest=p end end
    end
    return nearest or list[1]
