local function stopCurrentEmote()
    if currentEmoteTrack then
        pcall(function() currentEmoteTrack:Stop() end)
        currentEmoteTrack = nil
    end
end

local function stopAllEmotes()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
        pcall(function() t:Stop() end)
    end
end

-- ════════════════════════════════════════════════════════════
--  FORÇA PLAY DO EMOTE (via Animator direto)
-- ════════════════════════════════════════════════════════════
local function forcePlayEmote(emoteId, looped)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChild("Animator")
    if not animator then return end

    stopCurrentEmote()
    stopAllEmotes()

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(emoteId)

    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        Notify({ Title = "❌ Erro", Content = "Falha ao carregar emote ID: " .. tostring(emoteId), Duration = 3 })
        return
    end

    currentEmoteTrack          = track
    currentEmoteTrack.Priority = Enum.AnimationPriority.Action4
    currentEmoteTrack.Looped   = looped ~= false
    currentEmoteTrack:Play()

    if speedEmoteEnabled and SpeedBox then
        currentEmoteTrack:AdjustSpeed(tonumber(SpeedBox.Text) or 1)
    end

    getgenv().lastPlayedEmoteId = emoteId
end

-- ════════════════════════════════════════════════════════════
--  CONEXÕES DE CLIQUE NOS BOTÕES DA RODA
--  FIX: ordem correta dos slots 1-8 garantida com múltiplos
--       critérios de ordenação (Position.X, LayoutOrder, Name)
-- ════════════════════════════════════════════════════════════
local emoteSlotConns = {}

-- Mapeia a posição angular de cada slot para índice 1-8
-- A roda do Roblox distribui os slots em sentido horário a partir do topo.
-- Usamos Position para ordenar de forma confiável.
local function sortSlotsByWheelOrder(buttons)
    -- Tenta ordenar por LayoutOrder primeiro (se disponível e válido)
    local hasLayout = false
    for _, b in ipairs(buttons) do
        if b.LayoutOrder and b.LayoutOrder ~= 0 then
            hasLayout = true
            break
        end
    end

    if hasLayout then
        table.sort(buttons, function(a, b)
            return (a.LayoutOrder or 999) < (b.LayoutOrder or 999)
        end)
        return
    end

    -- Fallback: ordena pelo ângulo na roda (sentido horário, topo primeiro)
    -- Centro da roda = (0.5, 0.5)
    table.sort(buttons, function(a, b)
        local ax = a.Position.X.Scale - 0.5
        local ay = a.Position.Y.Scale - 0.5
        local bx = b.Position.X.Scale - 0.5
        local by = b.Position.Y.Scale - 0.5
        -- ângulo: 0 = topo, cresce horário
        local angA = math.atan2(ax, -ay)
        local angB = math.atan2(bx, -by)
        if angA < 0 then angA = angA + math.pi * 2 end
        if angB < 0 then angB = angB + math.pi * 2 end
        return angA < angB
    end)
end

local function connectEmoteSlots()
    for _, c in pairs(emoteSlotConns) do
        if c then pcall(function() c:Disconnect() end) end
    end
    emoteSlotConns = {}

    local front = getFront()
    if not front then return end

    local tab = TABS[currentTab]

    local buttons = {}
    for _, child in pairs(front:GetChildren()) do
        if child:IsA("ImageLabel") then
            table.insert(buttons, child)
        end
    end

    -- Ordena pelos slots na ordem certa 1→8
    sortSlotsByWheelOrder(buttons)

    for i, imgLabel in ipairs(buttons) do
        local id = tab.ids[i]
        if id and id ~= 0 then
            local btn = imgLabel:FindFirstChild("CEW_Slot")
            if not btn then
                btn = Instance.new("TextButton")
                btn.Name = "CEW_Slot"
                btn.Size = UDim2.new(1,0,1,0)
                btn.BackgroundTransparency = 1
                btn.Text = ""
                btn.ZIndex = imgLabel.ZIndex + 10
                btn.Parent = imgLabel
            end

            local capturedId = id
            local capturedSlot = i
            local conn = btn.MouseButton1Click:Connect(function()
                if favoriteEnabled then return end
                forcePlayEmote(capturedId)
                Notify({
                    Title   = "🎭 Slot " .. capturedSlot .. " — " .. (nameCache[capturedId] or "Emote"),
                    Content = "Emote iniciado!",
                    Duration = 2
                })
            end)
            table.insert(emoteSlotConns, conn)
        else
            -- slot vazio: remove botão se existir
            local btn = imgLabel:FindFirstChild("CEW_Slot")
            if btn then btn:Destroy() end
        end
    end
end

-- ════════════════════════════════════════════════════════════
--  INJETAR ABA ATUAL NA RODA
--  FIX: usa prefixo "S<slot>_" no nome → garante unicidade
--       e preserva a ordem exata dos slots 1-8
-- ════════════════════════════════════════════════════════════
local function injectCurrentTab()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end

    if hum.RigType == Enum.HumanoidRigType.R6 then
        Notify({ Title = "⚠️", Content = "R6 não suportado. Use R15.", Duration = 5 })
        return
    end

    local hd = hum:FindFirstChildOfClass("HumanoidDescription")
    if not hd then hd = hum.HumanoidDescription end
    if not hd then return end

    local tab        = TABS[currentTab]
    local emoteTable = {}
    local equipped   = {}

    for i = 1, math.min(#tab.ids, 8) do
        local id = tab.ids[i]
        if id and id ~= 0 then
            -- CRÍTICO: prefixo "S<i>_" garante que cada slot é único
            -- e mantém a ordem 1-8 exatamente como configurado
            local baseName = nameCache[id] or ("E" .. tostring(id))
            -- Limita tamanho e remove caracteres problemáticos
            baseName = baseName:gsub("[^%w%s_%-]", ""):sub(1, 30)
            local slotName = "S" .. i .. "_" .. baseName

            emoteTable[slotName] = { id }
            equipped[i]          = slotName
        end
    end

    pcall(function()
        hd:SetEmotes(emoteTable)
        hd:SetEquippedEmotes(equipped)
    end)

    task.delay(0.3, connectEmoteSlots)
end

