local GG_SAVE_FILE = "GGScript_v11_save.json"

-- Converte "Alt+F2" → {Enum.KeyCode.LeftAlt, Enum.KeyCode.F2}
local function ParseKeyStr(str)
    local keys = {}
    for part in (str or ""):gmatch("[^+]+") do
        local ok, kc = pcall(function() return Enum.KeyCode[part] end)
        if ok and kc and kc ~= Enum.KeyCode.Unknown then table.insert(keys, kc) end
    end
    return #keys > 0 and keys or {Enum.KeyCode.F2}
end

