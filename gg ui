-- ── FOV Arrows (dentro de BuildMenus para não usar locals do main chunk) ──
local FOVArrowDrawings = {}
local function UpdateFOVArrows()
    for _,d in ipairs(FOVArrowDrawings) do pcall(function() d:Remove() end) end
    FOVArrowDrawings={}
    if not State.ESP_FOVArrows or not Drawing then return end
    local viewportCenter=Camera.ViewportSize/2
    local refPoint=State.AimbotMode=="Center" and viewportCenter or Vector2.new(Mouse.X,Mouse.Y)
    local maxRange=math.clamp(State.ESP_FOVArrowRange,50,2000)
    for _,player in ipairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        if not IsAlive(player) then continue end
        local hrp=GetHRP(player) if not hrp then continue end
        local dist3d=GetDistance(player) if dist3d>maxRange then continue end
        local screenPos,onScreen=WorldToScreen(hrp.Position)
        local dir=(screenPos-refPoint) if dir.Magnitude<0.01 then continue end
        local dirNorm=dir.Unit
        local fovR=State.AimbotFOV
        local arrowPos=refPoint+dirNorm*fovR
        local col
        if State.AimbotFOVTeamColor then
            local tc=player.TeamColor col=tc and tc.Color or Color3.fromRGB(255,60,60)
        elseif dist3d<60  then col=Color3.fromRGB(0,255,80)
        elseif dist3d<150 then col=Color3.fromRGB(255,200,0)
        else                   col=Color3.fromRGB(255,50,50) end
        local arrowLen=14; local perpDir=Vector2.new(-dirNorm.Y,dirNorm.X)
        local lineD=Drawing.new("Line"); lineD.Visible=true; lineD.From=arrowPos-dirNorm*arrowLen; lineD.To=arrowPos; lineD.Color=col; lineD.Thickness=2; table.insert(FOVArrowDrawings,lineD)
        local tipL=Drawing.new("Line"); tipL.Visible=true; tipL.From=arrowPos; tipL.To=arrowPos-dirNorm*7+perpDir*5; tipL.Color=col; tipL.Thickness=2; table.insert(FOVArrowDrawings,tipL)
        local tipR=Drawing.new("Line"); tipR.Visible=true; tipR.From=arrowPos; tipR.To=arrowPos-dirNorm*7-perpDir*5; tipR.Color=col; tipR.Thickness=2; table.insert(FOVArrowDrawings,tipR)
        local nameD=Drawing.new("Text"); nameD.Visible=true; nameD.Text=player.Name; nameD.Position=arrowPos+Vector2.new(-30,-18); nameD.Color=col; nameD.Size=11; nameD.Font=2; nameD.Outline=true; table.insert(FOVArrowDrawings,nameD)
    end
end
-- ── Aim Shake ──
local function UpdateAimShake(dt)
    if not State.AimShake then AimShakeOffset=CFrame.new(); return end
    AimShakeTimer = AimShakeTimer + dt*8
    local str = math.clamp((State.AimShakeStr or 50)/100*0.06, 0.001, 0.06)
    local rx = math.sin(AimShakeTimer*3.1)*str
    local ry = math.cos(AimShakeTimer*2.7)*str
    AimShakeOffset = CFrame.Angles(rx,ry,0)
end
-- ── Aim Assist ──
local function UpdateAimAssist()
    if not State.AimAssist then return end
    local target = GetAimbotTarget(); if not target then return end
    local bonePos = target.getPos(); if not bonePos then return end
    -- Aim Assist não usa câmera Scriptable, só empurra suavemente
    local str = math.clamp((State.AimAssistStr or 30)/100*0.08, 0.001, 0.08)
    local targetCF = CFrame.lookAt(Camera.CFrame.Position, bonePos)
    pcall(function() Camera.CFrame = Camera.CFrame:Lerp(targetCF, str) end)
end
