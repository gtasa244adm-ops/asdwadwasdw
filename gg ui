_G.SL_Bound = true
RunService:BindToRenderStep("ShiftLockUpdate", Enum.RenderPriority.Camera.Value + 1, function()
    if not locked then return end

    UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter

    -- No veículo: não faz nada, câmera nativa funciona normal
    -- ✅ A sensibilidade do jogador já é respeitada automaticamente
    --    porque não estamos sobrescrevendo a câmera do veículo
    if isInVehicle() then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Rotaciona o personagem com a câmera (igual Roblox)
    local _, yaw, _ = Camera.CFrame:ToEulerAnglesYXZ()
    hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)

    -- ✅ Offset lateral usando a sensibilidade real do jogador
    -- UserGameSettings.MouseSensitivity vai de 0 a 1 (padrão ~0.5)
    -- O Roblox multiplica internamente por isso pra mover a câmera
    -- Aqui só aplicamos o offset de posição (não afeta sensibilidade de rotação)
    local camRight = Camera.CFrame.RightVector
    Camera.CFrame = CFrame.new(
        Camera.CFrame.Position + camRight * CONFIG.OffsetX,
        Camera.Focus.Position  + camRight * CONFIG.OffsetX
    )
end)

