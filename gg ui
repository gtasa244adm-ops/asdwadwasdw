local function SaveSettings()
    local ok_save = false
    pcall(function()
        local data = { _v = "11", _t = os.time and os.time() or 0 }

        -- ── 1. TODO o State ──
        for k, v in pairs(State) do
            local t = type(v)
            if t == "boolean" or t == "number" or t == "string" then
                data["S_"..k] = v
            end
        end

        -- ── 2. CFG (via _G bridge — CFG declarado depois desta função) ──
        local _cfg = _G._GGCFG or CFG
        data["_Key"]      = _cfg.OpenKeyStr or "F2"
        data["_Side"]     = _cfg.MenuSide   or "Esquerda"
        data["_RGBSpd"]   = _cfg.RGBSpeed   or 3
        data["_AutoSave"] = AutoSaveEnabled
        data["_AutoLoad"] = AutoLoadEnabled

        -- ── 3. RGB real (via _G bridge) ──
        pcall(function()
            if _G._GGRGBGet then
                local spd,hue = _G._GGRGBGet()
                data["_RGBSpdVar"] = spd
                data["_RGBHue"]    = hue
            end
        end)

        -- ── 4. KeyBinds (via _G bridge — KeyBindMap declarado depois) ──
        local binds = {}
        pcall(function()
            local kbmap = _G._GGKeyBindMap or KeyBindMap
            for it,bind in pairs(kbmap) do
                if it and it.label and bind and bind.str then binds[it.label]=bind.str end
            end
        end)
        pcall(function()
            if _G._GGKBGet then
                local mod,trg,str = _G._GGKBGet()
                data["_KBMod"] = tostring(mod):match("KeyCode%.(.+)") or tostring(mod)
                data["_KBTrg"] = tostring(trg):match("KeyCode%.(.+)") or tostring(trg)
                data["_KBStr"] = str
            end
        end)
        data["_Binds"] = binds

        -- ── 5. Posição painel e botão (via _G bridge) ──
        pcall(function()
            local pnl=_G._GGPanel
            if pnl then data["_PanelX"]=pnl.Position.X.Offset; data["_PanelY"]=pnl.Position.Y.Offset end
        end)
        pcall(function()
            local btn=_G._GGBtn
            if btn then data["_BtnX"]=btn.Position.X.Offset; data["_BtnY"]=btn.Position.Y.Offset end
        end)

        local encOk, json = pcall(function() return HttpService:JSONEncode(data) end)
        if not encOk or not json then return end
        pcall(function() if writefile then writefile(GG_SAVE_FILE, json) end end)
        pcall(function() LocalPlayer:SetAttribute("GGSave_v11", json) end)
        pcall(function() LocalPlayer:SetAttribute("GGSave_v11_bkp", json) end)
        ok_save = true
    end)
    return ok_save
end

local function LoadSettings()
    local loaded = false
    local data   = nil

    -- Fonte 1: writefile
    pcall(function()
        if readfile and isfile and isfile(GG_SAVE_FILE) then
            local raw = readfile(GG_SAVE_FILE)
            if raw and raw ~= "" then
                local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and d then data = d; loaded = true end
            end
        end
    end)
    -- Fonte 2: SetAttribute
    if not loaded then
        pcall(function()
            local raw = LocalPlayer:GetAttribute("GGSave_v11")
            if raw and raw ~= "" then
                local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and d then data = d; loaded = true end
            end
        end)
    end
    -- Fonte 3: backup
    if not loaded then
        pcall(function()
            local raw = LocalPlayer:GetAttribute("GGSave_v11_bkp")
            if raw and raw ~= "" then
                local ok, d = pcall(function() return HttpService:JSONDecode(raw) end)
                if ok and d then data = d; loaded = true end
            end
        end)
    end

    if not (loaded and data) then return false end

    -- ── Restaurar State ──
    for k, v in pairs(data) do
        if type(k) == "string" and k:sub(1,2) == "S_" then
            local sk = k:sub(3)
            if State[sk] ~= nil then
                local expected = type(State[sk])
                if type(v) == expected then
                    State[sk] = v
                end
            end
        end
    end

    -- ── Restaurar CFG + RECONSTRUIR OpenKeys (tecla de abrir) ──
    local _cfg = _G._GGCFG
    if not _cfg then
        -- CFG ainda não foi declarado (LoadSettings pode rodar antes do CFG)
        -- Salva para ser aplicado quando CFG for criado
        if data["_Key"] then pcall(function() if _G._GGCFG then _G._GGCFG.OpenKeyStr=data["_Key"] _G._GGCFG.OpenKeys=ParseKeyStr(data["_Key"]) end end) end
    end
    if _cfg and data["_Key"] then
        _cfg.OpenKeyStr = data["_Key"]
        -- ParseKeyStr está declarado ANTES desta função, funciona correto
        _cfg.OpenKeys = ParseKeyStr(data["_Key"])
        -- Atualiza labels na UI (podem ainda não existir, pcall protege)
        pcall(function() if _G._GGCfgKeyDisp then _G._GGCfgKeyDisp.label="Tecla Abrir:  "..data["_Key"] end end)
        pcall(function() if _G._GGRootKeyDisp then _G._GGRootKeyDisp.label="GG Script v11.0  |  "..data["_Key"].." = Toggle" end end)
    end
    if _cfg then
        if data["_Side"]   then _cfg.MenuSide = data["_Side"]  end
        if data["_RGBSpd"] then _cfg.RGBSpeed = data["_RGBSpd"] end
    end
    if data["_AutoSave"] ~= nil then AutoSaveEnabled = data["_AutoSave"] end
    if data["_AutoLoad"] ~= nil then AutoLoadEnabled = data["_AutoLoad"] end

    -- ── Restaurar RGB real (via _G bridge) ──
    pcall(function()
        if _G._GGRGBSet then
            local spd=data["_RGBSpdVar"]; local hue=data["_RGBHue"]
            _G._GGRGBSet((type(spd)=="number") and spd or nil,(type(hue)=="number") and hue or nil)
        end
    end)

    -- ── Restaurar KB primitives (via _G bridge) ──
    pcall(function()
        if _G._GGKBSet then
            if data["_KBMod"] then local kc=nil pcall(function() kc=Enum.KeyCode[data["_KBMod"]] end) if kc then _G._GGKBSet(kc,nil,nil) end end
            if data["_KBTrg"] then local kc=nil pcall(function() kc=Enum.KeyCode[data["_KBTrg"]] end) if kc then _G._GGKBSet(nil,kc,nil) end end
            if data["_KBStr"] then _G._GGKBSet(nil,nil,data["_KBStr"]) end
        else
            if data["_KBMod"] then local kc=nil pcall(function() kc=Enum.KeyCode[data["_KBMod"]] end) if kc then KBActivateMod=kc end end
            if data["_KBTrg"] then local kc=nil pcall(function() kc=Enum.KeyCode[data["_KBTrg"]] end) if kc then KBActivateTrg=kc end end
            if data["_KBStr"] then KBActivateStr=data["_KBStr"] end
        end
    end)

    -- ── Restaurar binds de item (via _G bridge) ──
    pcall(function()
        local binds = data["_Binds"]
        if type(binds) ~= "table" then return end
        local kbmap = _G._GGKeyBindMap or KeyBindMap
        local function scanMenu(menu, seen)
            if not menu or seen[menu] then return end
            seen[menu] = true
            for _, it in ipairs(menu.items or {}) do
                if it.label and binds[it.label] then
                    local kc=nil pcall(function() kc=Enum.KeyCode[binds[it.label]] end)
                    if kc then kbmap[it]={key=kc,str=binds[it.label]} end
                end
                if it.tipo=="submenu" and it.subm then scanMenu(it.subm,seen) end
            end
        end
        if MS and MS.root then scanMenu(MS.root,{}) end
    end)

    -- ── Restaurar posição painel e botão (via _G bridge) ──
    pcall(function()
        if data["_PanelX"] and _G._GGPanel then
            local px=tonumber(data["_PanelX"]); local py=tonumber(data["_PanelY"])
            if px and py then _G._GGPanel.Position=UDim2.new(0,px,DIM and DIM.PY or 0.5,py) end
        end
    end)
    pcall(function()
        if data["_BtnX"] and _G._GGBtn then
            local bx=tonumber(data["_BtnX"]); local by=tonumber(data["_BtnY"])
            if bx and by then _G._GGBtn.Position=UDim2.new(0,bx,0.5,by) end
        end
    end)

    -- ── Reaplicar features ──
    task.spawn(function()
        task.wait(0.5)
        pcall(function() if State.Fly           then SetupFly()            end end)
        pcall(function() if State.InfiniteJump  then SetupInfiniteJump()   end end)
        pcall(function() if State.HitboxExpand  then SetupHitboxExpand()   end end)
        pcall(function() if State.AutoClick     then SetupAutoClick()      end end)
        pcall(function() if State.FakeLag       then SetupFakeLag()        end end)
        pcall(function() if State.Fullbright    then ApplyFullbright()     end end)
        pcall(function() if State.NoFog         then ApplyNoFog()          end end)
        pcall(function() if State.RemoveTrees   then ApplyRemoveTrees()    end end)
        pcall(function() if State.ShowCustomName then ApplyCustomName()    end end)
        pcall(function() if State.ThirdPerson   then SetupThirdPerson()    end end)
        pcall(function() if State.Minimap       then CreateMinimap()       end end)
        pcall(function() if State.WalkOnWater   then SetupWalkOnWater()    end end)
        pcall(function() if State.Noclip        then _G.V11.SetupNoclip()  end end)
        pcall(function() if State.AntiStun      then _G.V11.SetupAntiStun() end end)
        pcall(function() if State.RemoveWater   then _G.V11.ApplyRemoveWater() end end)
        pcall(function() if State.RemoveShadows then _G.V11.ApplyRemoveShadows() end end)
        pcall(function() if State.FreezeDawn    then _G.V11.ApplyFreezeDawn() end end)
        pcall(function() if State.FreezeTime    then _G.V11.ApplyFreezeTime() end end)
        pcall(function() if State.AirPlatform   then _G.V11.SetupAirPlatform() end end)
        pcall(function() if State.FreeCamera    then _G.V11.SetupFreeCamera() end end)
        pcall(function() if State.TrailEnabled  then _G.V11.SetupTrail()   end end)
        pcall(function() _G.V11.SetupJumpHeight() end)
        pcall(function()
            if State.ActiveTheme and _G.V11 and _G.V11.ApplyTheme then
                _G.V11.ApplyTheme(State.ActiveTheme)
            end
        end)
        -- Reaplica Aimbot/SilentAim/Triggerbot se estavam ativos
        pcall(function() if State.SilentAim   then SetupSilentAim()   end end)
        pcall(function() if State.Triggerbot  then SetupTriggerbot()  end end)
        -- Atualiza a UI
        task.wait(0.1)
        pcall(function() Render() end)
    end)

    task.defer(function() pcall(function() if _G._GGSyncToggles then _G._GGSyncToggles() end end) end)
    return true
end

