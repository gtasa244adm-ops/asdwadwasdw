-- Minimap
local function CreateMinimap()
    if Misc.MinimapGui then Misc.MinimapGui:Destroy() end
    Misc.MinimapGui = Instance.new("ScreenGui")
    Misc.MinimapGui.Name = "GGMinimap"
    Misc.MinimapGui.ResetOnSpawn = false
    Misc.MinimapGui.IgnoreGuiInset = true
    Misc.MinimapGui.Parent = PlayerGui

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 160, 0, 160)
    frame.Position = UDim2.new(1, -175, 1, -175)
    frame.BackgroundColor3 = Color3.fromRGB(10, 10, 20)
    frame.BackgroundTransparency = 0.2
    frame.BorderSizePixel = 0
    frame.Parent = Misc.MinimapGui
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 80)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 16)
    title.Position = UDim2.new(0, 0, 0, -18)
    title.BackgroundTransparency = 1
    title.Text = "RADAR"
    title.TextColor3 = Color3.fromRGB(180, 180, 220)
    title.TextSize = 12
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    -- store frame for updates
    Misc.MinimapGui:SetAttribute("Frame", frame.Name)
    Misc.MinimapGui.Frame = frame
end

local function UpdateMinimap()
    if not Misc.MinimapGui or not Misc.MinimapGui.Parent then return end
    local frame = Misc.MinimapGui.Frame
    if not frame then return end
    local myHRP = GetHRP(LocalPlayer)
    if not myHRP then return end

    -- Clear old dots
    for k, dot in pairs(Misc.MinimapDots) do
        if not k.Parent then
            dot:Destroy()
            Misc.MinimapDots[k] = nil
        end
    end

    local scale = 2 -- studs per pixel
    local center = Vector2.new(80, 80)

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local pHRP = GetHRP(player)
        if not pHRP then continue end

        if not Misc.MinimapDots[player] then
            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0, 8, 0, 8)
            dot.BackgroundColor3 = IsEnemy(player) and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 100)
            dot.BorderSizePixel = 0
            dot.ZIndex = 2
            dot.Parent = frame
            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0, 60, 0, 12)
            lbl.Position = UDim2.new(0, 10, 0, -2)
            lbl.BackgroundTransparency = 1
            lbl.Text = player.Name
            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            lbl.TextSize = 9
            lbl.Font = Enum.Font.Gotham
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.ZIndex = 3
            lbl.Parent = dot
            Misc.MinimapDots[player] = dot
        end

        local relPos = pHRP.Position - myHRP.Position
        local dx = relPos.X / scale
        local dy = relPos.Z / scale
        local px = math.clamp(center.X + dx, 5, 155)
        local py = math.clamp(center.Y + dy, 5, 155)
        Misc.MinimapDots[player].Position = UDim2.new(0, px - 4, 0, py - 4)
        Misc.MinimapDots[player].BackgroundColor3 = IsEnemy(player)
            and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 100)
    end
end

local function DestroyMinimap()
    if Misc.MinimapGui then Misc.MinimapGui:Destroy() Misc.MinimapGui = nil end
    Misc.MinimapDots = {}
end

