-- ==================== SUGESTÕES ====================
local function getSuggestions(text)
    local s = {}; text = text:lower()
    for name, cmd in pairs(CommandList) do
        if name:sub(1, #text) == text then table.insert(s, {name=name, desc=cmd.desc}) end
    end
    table.sort(s, function(a,b) return a.name < b.name end); return s
end

local function updateSuggestions(input)
    local firstWord = input:match("^(%S+)") or ""; local suggs = getSuggestions(firstWord)
    for _, ch in ipairs(SuggestFrame:GetChildren()) do if ch:IsA("TextButton") then ch:Destroy() end end
    if #suggs == 0 or firstWord == "" then SuggestFrame.Visible = false; return end

    local maxShow = math.min(#suggs, 7); local itemH = 30
    SuggestFrame.Visible = true; SuggestFrame.Size = UDim2.new(1, 0, 0, maxShow * itemH)

    for i = 1, maxShow do
        local s = suggs[i]
        local btn = Instance.new("TextButton", SuggestFrame)
        btn.Size = UDim2.new(1, 0, 0, itemH); btn.BackgroundColor3 = THEME.suggest
        btn.Text = ""; btn.LayoutOrder = i; btn.ZIndex = 106
        if i == maxShow and maxShow < #suggs then btn.BackgroundColor3 = Color3.fromRGB(12,12,12) end

        local sn = Instance.new("TextLabel", btn)
        sn.Size = UDim2.new(0, 160, 1, 0); sn.Position = UDim2.new(0, 10, 0, 0)
        sn.BackgroundTransparency = 1; sn.Text = ";"..s.name
        sn.TextColor3 = THEME.cmd; sn.Font = Enum.Font.GothamBold; sn.TextSize = 13
        sn.TextXAlignment = Enum.TextXAlignment.Left; sn.ZIndex = 107

        local sd = Instance.new("TextLabel", btn)
        sd.Size = UDim2.new(1, -165, 1, 0); sd.Position = UDim2.new(0, 165, 0, 0)
        sd.BackgroundTransparency = 1; sd.Text = s.desc
        sd.TextColor3 = THEME.subtext; sd.Font = Enum.Font.Gotham; sd.TextSize = 12
        sd.TextXAlignment = Enum.TextXAlignment.Left; sd.ZIndex = 107

        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = THEME.suggestHover end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = THEME.suggest end)
        local captName = s.name
        btn.MouseButton1Click:Connect(function()
            CmdInput.Text = captName.." "; CmdInput:CaptureFocus(); SuggestFrame.Visible = false
        end)
    end
end

