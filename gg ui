--  🎒 OVERLAY DE PACKS (suporta N packs com scroll automático)
-- ════════════════════════════════════════════════════════════
local packOverlayFrame = nil
local packOverlayOpen  = false
local currentPackTab   = 1  -- aba atual do overlay de packs

local function refreshPackLabel()
    if PackLabel and PackLabel.Parent then
        if currentAnimPackIdx == 0 then
            PackLabel.Text = "🎒 Normal"
        else
            PackLabel.Text = "🎒 " .. getAnimPack().packName
        end
    end
end

local function applyPackByIdx(idx)
    if idx == 0 then
        originalMoveAnims = {}
        local char = Player.Character
        if char then resetMoveAnims(char) end
        currentAnimPackIdx = 0
    else
        currentAnimPackIdx = idx
        originalMoveAnims  = {}
        local char = Player.Character
        if char then applyMoveAnims(char) end
    end
    refreshPackLabel()
end

-- ════════════════════════════════════════════════════════════
--  Renderiza os botões de pack da aba atual dentro do frame
-- ════════════════════════════════════════════════════════════
local packTabLabel    = nil  -- ref ao TextLabel da aba no overlay
local packTabCounter  = nil  -- ref ao "X / Y" do overlay

local function renderPackPage(frame)
    -- Remove botões de pack anteriores
    for _, ch in ipairs(frame:GetChildren()) do
        if ch.Name == "CEW_PackBtn" then ch:Destroy() end
    end

    local totalPackTabs = #PACK_TABS
    if currentPackTab > totalPackTabs then currentPackTab = 1 end
    if currentPackTab < 1 then currentPackTab = totalPackTabs end

    local tab      = PACK_TABS[currentPackTab]
    local idxList  = tab and tab.packIdxs or {}

    -- Atualiza barra superior do overlay
    if packTabLabel   and packTabLabel.Parent   then
        packTabLabel.Text = tab and tab.tabName or ("Tab " .. currentPackTab)
    end
    if packTabCounter and packTabCounter.Parent then
        packTabCounter.Text = currentPackTab .. " / " .. totalPackTabs
    end

    -- ── Layout grade 2 colunas × 4 linhas ao redor do círculo ──
    -- Coluna esquerda: slots 1,2,3,4  |  Coluna direita: slots 5,6,7,8
    local bW = 0.215   -- largura do botão (escala)
    local bH = 0.115   -- altura do botão (escala)
    local gapY = 0.005 -- espaço vertical entre botões

    -- Posições X das duas colunas
    local xLeft  = -0.01   -- coluna esquerda (fora do círculo à esquerda)
    local xRight = 0.795   -- coluna direita (fora do círculo à direita)

    -- As 4 linhas verticais distribuídas de 0.10 a 0.78
    local rows = { 0.10, 0.28, 0.50, 0.68 }

    -- slot → {xScale, yScale}
    local positions = {
        { xLeft,  rows[1] }, -- slot 1
        { xLeft,  rows[2] }, -- slot 2
        { xLeft,  rows[3] }, -- slot 3
        { xLeft,  rows[4] }, -- slot 4
        { xRight, rows[1] }, -- slot 5
        { xRight, rows[2] }, -- slot 6
        { xRight, rows[3] }, -- slot 7
        { xRight, rows[4] }, -- slot 8
    }

    for slot = 1, math.min(#idxList, 8) do
        local globalIdx = idxList[slot]
        local pack      = ANIM_PACKS[globalIdx]
        if not pack then continue end
        local isActive  = (currentAnimPackIdx == globalIdx)

        local px = positions[slot][1]
        local py = positions[slot][2]

        local btn = Instance.new("TextButton")
        btn.Name                   = "CEW_PackBtn"
        btn.Size                   = UDim2.new(bW, 0, bH, 0)
        btn.Position               = UDim2.new(px, 0, py, 0)
        btn.BackgroundColor3       = isActive and Color3.fromRGB(30,70,130) or Color3.fromRGB(12,12,30)
        btn.BackgroundTransparency = 0.08
        btn.BorderSizePixel        = 0
        btn.Text                   = pack.packName
        btn.TextColor3             = isActive and Color3.fromRGB(140,200,255) or Color3.fromRGB(210,210,255)
        btn.TextScaled             = true
        btn.Font                   = Enum.Font.GothamBold
        btn.ZIndex                 = 22
        btn.AutoButtonColor        = false
        btn.Parent                 = frame
        local bC = Instance.new("UICorner"); bC.CornerRadius = UDim.new(0,10); bC.Parent = btn
        local bS = Instance.new("UIStroke")
        bS.Color     = isActive and Color3.fromRGB(100,160,255) or Color3.fromRGB(60,60,160)
        bS.Thickness = isActive and 2 or 1.2
        bS.Parent    = btn

        -- indicador lateral colorido (ativo = azul, inativo = transparente)
        local accent2 = Instance.new("Frame")
        accent2.Size             = UDim2.new(0,3,0.7,0)
        accent2.Position         = UDim2.new(0,0,0.15,0)
        accent2.BackgroundColor3 = isActive and Color3.fromRGB(100,160,255) or Color3.fromRGB(50,50,120)
        accent2.BackgroundTransparency = isActive and 0 or 0.5
        accent2.BorderSizePixel  = 0
        accent2.ZIndex           = 23
        accent2.Parent           = btn
        local aC = Instance.new("UICorner"); aC.CornerRadius=UDim.new(0,4); aC.Parent=accent2

        btn.MouseEnter:Connect(function()
            if currentAnimPackIdx ~= globalIdx then
                btn.BackgroundColor3 = Color3.fromRGB(25,25,55)
            end
        end)
        btn.MouseLeave:Connect(function()
            if currentAnimPackIdx ~= globalIdx then
                btn.BackgroundColor3 = Color3.fromRGB(12,12,30)
            end
        end)

        local capturedIdx = globalIdx
        btn.MouseButton1Click:Connect(function()
            applyPackByIdx(capturedIdx)
            packOverlayOpen = false
            frame.Visible   = false
        end)
    end
end

local function buildPackOverlay(wheel)
    local old = wheel:FindFirstChild("CEW_PackOverlay")
    if old then old:Destroy() end

    local totalPackTabs = #PACK_TABS
    if currentPackTab > totalPackTabs then currentPackTab = 1 end

    -- Frame principal (cobre a roda)
    local frame = Instance.new("Frame")
    frame.Name                   = "CEW_PackOverlay"
    frame.Size                   = UDim2.new(1, 0, 1, 0)
    frame.Position               = UDim2.new(0, 0, 0, 0)
    frame.BackgroundColor3       = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel        = 0
    frame.ZIndex                 = 20
    frame.Visible                = false
    frame.Parent                 = wheel
    local fC = Instance.new("UICorner"); fC.CornerRadius = UDim.new(1,0); fC.Parent = frame

    -- ══════════════════════════════════════════════════════
    --  BARRA SUPERIOR DE ABAS DE PACKS
    -- ══════════════════════════════════════════════════════
    local packTopBar = Instance.new("Frame")
