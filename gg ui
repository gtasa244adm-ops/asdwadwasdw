-- Wall checks com params reutilizados
local function WallCheckClear(pos, character)
    local origin = Camera.CFrame.Position
    local dir = pos - origin
    _aimRPParams.FilterDescendantsInstances = {LocalPlayer.Character, Workspace.Terrain}
    local result = Workspace:Raycast(origin, dir.Unit * dir.Magnitude, _aimRPParams)
    if not result then return true end
    return character and result.Instance:IsDescendantOf(character)
end

local function AutoWallCheck(pos, character)
    local origin = Camera.CFrame.Position
    local dir = pos - origin
    _aimRPParams.FilterDescendantsInstances = {LocalPlayer.Character, Workspace.Terrain}
    local result = Workspace:Raycast(origin, dir.Unit * dir.Magnitude, _aimRPParams)
    if not result then return true end
    if character and result.Instance:IsDescendantOf(character) then return true end
    if result.Instance and result.Instance:IsA("BasePart") then
        local s = result.Instance.Size
        return math.min(s.X,s.Y,s.Z) < 2
    end
    return false
end

-- Melhor osso disponível
local function GetBestBone(player)
    local boneStr = State.AimbotBone or "Head"
    local c = GetCharacter(player)
    if not c then return nil end
    if State.HeadBodySwap then
        local head = c:FindFirstChild("Head")
        if head and WallCheckClear(head.Position, c) then return head.Position end
        local torso = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
        return torso and torso.Position
    end
    local part = c:FindFirstChild(boneStr)
    if part then return part.Position end
    -- Fallback hierárquico
    local fallbacks = {"Head","UpperTorso","Torso","HumanoidRootPart"}
    for _,fb in ipairs(fallbacks) do
        local fp = c:FindFirstChild(fb)
        if fp then return fp.Position end
    end
    return nil
end

-- Predição de posição
local function GetPredictedPosition(player, bonePos)
    local tHRP = GetHRP(player)
    if not tHRP then return bonePos end
    local vel = tHRP.AssemblyLinearVelocity
    local dist = (Camera.CFrame.Position - bonePos).Magnitude
    if State.AimPredictionAdv then
        local projSpeed = math.clamp((State.AimProjSpeed or 50)/100*10000, 100, 10000)
        local tt = dist / projSpeed
        return bonePos + vel*tt - Vector3.new(0,98.1,0)*tt*tt
    else
        return bonePos + vel*(dist/1000)
    end
end

