function _GGRender() Render() end

-- ── Scroll/Skip ──
local function FixScroll()
    local n=MS.cur and #MS.cur.items or 1
    MS.idx=math.clamp(MS.idx,1,math.max(n,1))
    if MS.idx<=MS.scroll then MS.scroll=MS.idx-1
    elseif MS.idx>MS.scroll+DIM.MaxR then MS.scroll=MS.idx-DIM.MaxR end
    MS.scroll=math.max(0,MS.scroll)
end
local function SkipDisp(dir)
    if not MS.cur then return end
    local items=MS.cur.items; local n=#items; if n==0 then return end
    local good=0; for _,it in ipairs(items) do if it.tipo~="display" then good=good+1 end end
    if good==0 then return end
    local idx=MS.idx
    for _=1,n do
        idx=idx+dir; if idx<1 then idx=n end; if idx>n then idx=1 end
        if items[idx].tipo~="display" then MS.idx=idx return end
    end
end
local function Refresh() FixScroll() Recalc() Render() end

-- ── Navegação ──
local function NavUp()
    if MS.inputOpen or MS.kbOpen then return end SkipDisp(-1) Refresh()
end
local function NavDown()
    if MS.inputOpen or MS.kbOpen then return end SkipDisp(1) Refresh()
end
local function NavLeft()
    if MS.inputOpen or MS.kbOpen then return end
    local it=MS.cur and MS.cur.items[MS.idx]; if not it then return end
    if it.tipo=="slider" then it.val=it.val-it.step if it.slCb then pcall(it.slCb,it.val) end Render()
    else if #MS.stack>0 then MS.cur=table.remove(MS.stack) MS.idx=1 MS.scroll=0 Refresh() end end
end
local function NavRight()
    if MS.inputOpen or MS.kbOpen then return end
    local it=MS.cur and MS.cur.items[MS.idx]; if not it then return end
    if it.tipo=="slider" then it.val=it.val+it.step if it.slCb then pcall(it.slCb,it.val) end Render()
    elseif it.tipo=="submenu" and it.subm then
        table.insert(MS.stack,MS.cur); MS.cur=it.subm; MS.idx=1; MS.scroll=0
        if MS.cur.items[1] and MS.cur.items[1].tipo=="display" then SkipDisp(1) end Refresh()
    end
end

local function Confirm()
    if MS.inputOpen or MS.kbOpen then return end
    local it=MS.cur and MS.cur.items[MS.idx]; if not it then return end
    if it.tipo=="action" then
        local ri=MS.idx-MS.scroll
        if Rows[ri] and Rows[ri].r.Visible then
            Rows[ri].r.BackgroundColor3=P.White
            task.delay(0.09,function() if Rows[ri] and Rows[ri].r.Visible then Rows[ri].r.BackgroundColor3=RGBC end end)
        end
        if it.cb then task.defer(it.cb) end
    elseif it.tipo=="toggle" then
        it.enabled=not it.enabled; if it.togCb then pcall(it.togCb,it.enabled) end Render()
    elseif it.tipo=="submenu" then NavRight()
    elseif it.tipo=="slider" or it.isText then OpenPopup(it)
    end
end

local GGDPad, GGBackBtn

local function GoBack()
    if MS.kbOpen then CloseKBCapture() return end
    if MS.inputOpen then ClosePopup() return end
    if #MS.stack>0 then MS.cur=table.remove(MS.stack) MS.idx=1 MS.scroll=0 Refresh()
    else
        MS.open=false
        local h=Panel.Size.Y.Offset
        Tw(Panel,{Position=UDim2.new(0,-(DIM.W+60),DIM.PY,-(h/2))},0.18,Enum.EasingStyle.Quint,Enum.EasingDirection.In)
        task.delay(0.20,function() Panel.Visible=false end)
        GGBtn.Text="▶ GG"
        if GGDPad    then GGDPad.Visible=false end
        if GGBackBtn then GGBackBtn.Visible=false end
    end
end

local function OpenMenu()
    if MS.open then return end
    MS.open=true; Panel.Visible=true
    if MS.root and not MS.cur then
        MS.cur=MS.root; MS.idx=1; MS.scroll=0
        if MS.cur.items[1] and MS.cur.items[1].tipo=="display" then SkipDisp(1) end
    end
    local offX=DIM.OpenX; FixScroll() Recalc() Render()
    local h=Panel.Size.Y.Offset
    Panel.Position=UDim2.new(0,-(DIM.W+60),DIM.PY,-(h/2))
    Tw(Panel,{Position=UDim2.new(0,offX,DIM.PY,-(h/2))},0.24,Enum.EasingStyle.Quint)
    GGBtn.Text="▼ GG"
    if GGDPad    then GGDPad.Visible=true end
    if GGBackBtn then GGBackBtn.Visible=true end
end

local function CloseMenu()
    if not MS.open then return end; MS.open=false
    if _popActive then ClosePopup() end; if MS.kbOpen then CloseKBCapture() end
    local h=Panel.Size.Y.Offset
    Tw(Panel,{Position=UDim2.new(0,-(DIM.W+60),DIM.PY,-(h/2))},0.18,Enum.EasingStyle.Quint,Enum.EasingDirection.In)
    task.delay(0.20,function() Panel.Visible=false end)
    GGBtn.Text="▶ GG"
    if GGDPad    then GGDPad.Visible=false end
    if GGBackBtn then GGBackBtn.Visible=false end
end

local function ToggleMenu() if MS.open then CloseMenu() else OpenMenu() end end
GGBtn.Activated:Connect(ToggleMenu)

-- ── Teclado ──
local nCool=false; local function Cool() nCool=true task.delay(0.11,function() nCool=false end) end

local function ComboTriggered(inp)
    if #CFG.OpenKeys==1 then return inp.KeyCode==CFG.OpenKeys[1] end
    local inCombo=false
    for _,k in ipairs(CFG.OpenKeys) do if inp.KeyCode==k then inCombo=true break end end
    if not inCombo then return false end
    for _,k in ipairs(CFG.OpenKeys) do if k~=inp.KeyCode and not UserInputService:IsKeyDown(k) then return false end end
    return true
end

UserInputService.InputBegan:Connect(function(inp,gpe)
    if gpe then return end
    if _popActive then return end
    if MS.kbOpen then return end
    if ComboTriggered(inp) then ToggleMenu() return end
    -- F2 e RShift também abrem (compatibilidade com original)
    if inp.KeyCode==Enum.KeyCode.RightShift then ToggleMenu() return end
    if not MS.open then return end
    if nCool then return end
    local k=inp.KeyCode
    if     k==Enum.KeyCode.Up    or k==Enum.KeyCode.W then NavUp()   Cool()
    elseif k==Enum.KeyCode.Down  or k==Enum.KeyCode.S then NavDown()  Cool()
    elseif k==Enum.KeyCode.Left  or k==Enum.KeyCode.A then NavLeft()  Cool()
    elseif k==Enum.KeyCode.Right or k==Enum.KeyCode.D then NavRight() Cool()
    elseif k==Enum.KeyCode.Return or k==Enum.KeyCode.KeypadEnter then Confirm() Cool()
    elseif k==Enum.KeyCode.Backspace or k==Enum.KeyCode.Escape then GoBack() Cool()
    elseif k==Enum.KeyCode.I then
        if InfoPanel then InfoPanel.Visible=not InfoPanel.Visible end
    end
end)

-- Segurar ↑/↓
do
    local hold,tick2=0,0
    RunService.Heartbeat:Connect(function(dt)
        if not MS.open or MS.inputOpen or MS.kbOpen then hold=0 tick2=0 return end
        local u=UserInputService:IsKeyDown(Enum.KeyCode.Up) or UserInputService:IsKeyDown(Enum.KeyCode.W)
        local dn=UserInputService:IsKeyDown(Enum.KeyCode.Down) or UserInputService:IsKeyDown(Enum.KeyCode.S)
        if u or dn then
            hold=hold+dt tick2=tick2+dt
            if hold>0.4 and tick2>0.09 then tick2=0 if u then NavUp() else NavDown() end end
        else hold=0 tick2=0 end
    end)
end

