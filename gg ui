_G.V11.SetupTrail = function()
    _G.V11.DestroyTrails()
    if not State.TrailEnabled then return end
    local char = LocalPlayer.Character; if not char then return end
    local transp = math.clamp(State.TrailTransp, 0, 1)
    local lifetime = math.clamp(State.TrailLifetime, 0.1, 10)
    local width = math.clamp(State.TrailWidth, 0.1, 20)
    for _, entry in ipairs(_G.V11.TrailPartMap) do
        if State[entry.key] then
            local part = char:FindFirstChild(entry.r15) or char:FindFirstChild(entry.r6)
            if part then
                local a0 = Instance.new("Attachment"); a0.Position=Vector3.new(0, 0.5, 0); a0.Parent=part
                local a1 = Instance.new("Attachment"); a1.Position=Vector3.new(0,-0.5, 0); a1.Parent=part
                local tr = Instance.new("Trail")
                tr.Attachment0 = a0; tr.Attachment1 = a1
                tr.Lifetime = lifetime; tr.MinLength = 0
                tr.WidthScale = NumberSequence.new(width)
                tr.Transparency = NumberSequence.new(transp)
                if State.TrailRGB then
                    tr.Color = ColorSequence.new(RGBC, Color3.fromHSV((RGBHue+0.33)%1,0.90,1))
                else
                    tr.Color = ColorSequence.new(Color3.fromRGB(255,100,255), Color3.fromRGB(100,200,255))
                end
                tr.Parent = part
                table.insert(_G.V11.Trails, {part=entry.key, obj=tr, a0=a0, a1=a1})
            end
        end
    end
end

