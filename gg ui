-- ── Força limpeza de qualquer estado travado de execução anterior ──
_G.GGBlock = {blocked=false, savedSpeed=16, aimCamSaved=false}
pcall(function()
    CAS:UnbindAction("GGBlk_W")    CAS:UnbindAction("GGBlk_A")
    CAS:UnbindAction("GGBlk_S")    CAS:UnbindAction("GGBlk_D")
    CAS:UnbindAction("GGBlk_Up")   CAS:UnbindAction("GGBlk_Down")
    CAS:UnbindAction("GGBlk_Left") CAS:UnbindAction("GGBlk_Right")
    CAS:UnbindAction("GGBlk_Space")
end)

_G.GGBlock.Block = function()
    if _G.GGBlock.blocked then return end
    _G.GGBlock.blocked = true
    -- Bloqueia APENAS as setas direcionais (não mexe no WASD para não travar o personagem)
    local SINK = function() return Enum.ContextActionResult.Sink end
    local PRIO = Enum.ContextActionPriority.High.Value + 9999
    pcall(function()
        -- Setas: bloqueadas permanentemente para não andar com elas (só navegam o menu)
        CAS:BindActionAtPriority("GGBlk_Up",    SINK, false, PRIO, Enum.KeyCode.Up)
        CAS:BindActionAtPriority("GGBlk_Down",  SINK, false, PRIO, Enum.KeyCode.Down)
        CAS:BindActionAtPriority("GGBlk_Left",  SINK, false, PRIO, Enum.KeyCode.Left)
        CAS:BindActionAtPriority("GGBlk_Right", SINK, false, PRIO, Enum.KeyCode.Right)
        -- Space bloqueado enquanto menu aberto
        CAS:BindActionAtPriority("GGBlk_Space", SINK, false, PRIO, Enum.KeyCode.Space)
    end)
end

_G.GGBlock.Unblock = function()
    -- Sem checar blocked — sempre remove os binds e restaura movimento
    _G.GGBlock.blocked = false
    pcall(function()
        CAS:UnbindAction("GGBlk_Up")   CAS:UnbindAction("GGBlk_Down")
        CAS:UnbindAction("GGBlk_Left") CAS:UnbindAction("GGBlk_Right")
        CAS:UnbindAction("GGBlk_Space")
    end)
    -- Garante que WalkSpeed nunca fica em 0 após fechar menu
    pcall(function()
        local hum = GetHumanoid(LocalPlayer)
        if hum and not State.Fly and hum.WalkSpeed <= 0 then
            hum.WalkSpeed = _G.GGBlock.savedSpeed > 0 and _G.GGBlock.savedSpeed or 16
        end
    end)
end

local function OpenMenu()
    if MS.open then return end
    MS.open=true; Panel.Visible=true
    if MS.root and not MS.cur then
        MS.cur=MS.root; MS.idx=1; MS.scroll=0
        if MS.cur.items[1] and MS.cur.items[1].tipo=="display" then SkipDisp(1) end
    end
    local offX=DIM.OpenX; FixScroll() Recalc() Render()
    local h=Panel.Size.Y.Offset
    Panel.Position=UDim2.new(0,-(DIM.W+60),DIM.PY,-(h/2))
    Tw(Panel,{Position=UDim2.new(0,offX,DIM.PY,-(h/2))},0.24,Enum.EasingStyle.Quint)
    GGBtn.Text="▼ GG"
    if _G._GGDPad    then _G._GGDPad.Visible=true end
    if _G._GGBackBtn then _G._GGBackBtn.Visible=true end
    if _G._GGEnterBtn then _G._GGEnterBtn.Visible=true end
    _G.GGBlock.Block()
end

local function CloseMenu()
    if not MS.open then return end; MS.open=false
    if _popActive then ClosePopup() end; if MS.kbOpen then CloseKBCapture() end
    local h=Panel.Size.Y.Offset
    Tw(Panel,{Position=UDim2.new(0,-(DIM.W+60),DIM.PY,-(h/2))},0.18,Enum.EasingStyle.Quint,Enum.EasingDirection.In)
    task.delay(0.20,function() Panel.Visible=false end)
    GGBtn.Text="▶ GG"
    if _G._GGDPad    then _G._GGDPad.Visible=false end
    if _G._GGBackBtn then _G._GGBackBtn.Visible=false end
    if _G._GGEnterBtn then _G._GGEnterBtn.Visible=false end
    _G.GGBlock.Unblock()
end

local function ToggleMenu() if MS.open then CloseMenu() else OpenMenu() end end
GGBtn.Activated:Connect(ToggleMenu)

-- ── Teclado ──
-- nCool desativado: sem delay entre teclas

local function ComboTriggered(inp)
    if #CFG.OpenKeys==1 then return inp.KeyCode==CFG.OpenKeys[1] end
    local inCombo=false
    for _,k in ipairs(CFG.OpenKeys) do if inp.KeyCode==k then inCombo=true break end end
    if not inCombo then return false end
    for _,k in ipairs(CFG.OpenKeys) do if k~=inp.KeyCode and not UserInputService:IsKeyDown(k) then return false end end
    return true
end

UserInputService.InputBegan:Connect(function(inp,gpe)
    -- ── KeyBind capture mode (capture antes de tudo) ──
    if KBCaptureMode and inp.UserInputType==Enum.UserInputType.Keyboard then
        local kc=inp.KeyCode
        if kc==Enum.KeyCode.Escape or kc==Enum.KeyCode.Backspace then KBCancel()
        elseif kc~=KBActivateMod and kc~=Enum.KeyCode.LeftControl
            and kc~=Enum.KeyCode.RightControl and kc~=Enum.KeyCode.LeftShift
            and kc~=Enum.KeyCode.RightShift and kc~=Enum.KeyCode.RightAlt then
            KBConfirm(kc)
        end
        return
    end
    -- ── Mudar Mod/Trigger do combo ──
    if MS.kbBindChangeMod and inp.UserInputType==Enum.UserInputType.Keyboard then
        local kc=inp.KeyCode
        KBActivateMod=kc
        KBActivateStr=( tostring(kc):match("KeyCode%.(.+)") or tostring(kc) ).."+"..
            ( tostring(KBActivateTrg):match("KeyCode%.(.+)") or tostring(KBActivateTrg) )
        MS.kbBindChangeMod=false
        Notify("Key Bind","Mod alterado: "..KBActivateStr,2)
        if MS.open then pcall(Render) end
        return
    end
    if MS.kbBindChangeTrg and inp.UserInputType==Enum.UserInputType.Keyboard then
        local kc=inp.KeyCode
        KBActivateTrg=kc
        KBActivateStr=( tostring(KBActivateMod):match("KeyCode%.(.+)") or tostring(KBActivateMod) ).."+"..
            ( tostring(kc):match("KeyCode%.(.+)") or tostring(kc) )
        MS.kbBindChangeTrg=false
        Notify("Key Bind","Trigger alterado: "..KBActivateStr,2)
        if MS.open then pcall(Render) end
        return
    end
    -- ── Ativar bind mode: KBActivateMod+KBActivateTrg ──
    if inp.UserInputType==Enum.UserInputType.Keyboard then
        if inp.KeyCode==KBActivateTrg and UserInputService:IsKeyDown(KBActivateMod) then
            local item=MS.cur and MS.cur.items[MS.idx]
            if item then KBStart(item) return end
        end
    end
    -- ── Disparar binds ativos (fora do menu) ──
    if not gpe and inp.UserInputType==Enum.UserInputType.Keyboard then
        for item,bind in pairs(KeyBindMap) do
            if inp.KeyCode==bind.key then pcall(KBExecItem,item) end
        end
    end
    if gpe then return end
    if _popActive then return end
    if MS.kbOpen then return end
    if ComboTriggered(inp) then ToggleMenu() return end
    if not MS.open then return end
    -- Só setinhas navegam o menu — WASD não interfere
    local k=inp.KeyCode
    if     k==Enum.KeyCode.Up    then NavUp()
    elseif k==Enum.KeyCode.Down  then NavDown()
    elseif k==Enum.KeyCode.Left  then NavLeft()
    elseif k==Enum.KeyCode.Right then NavRight()
    elseif k==Enum.KeyCode.Return or k==Enum.KeyCode.KeypadEnter then Confirm()
    elseif k==Enum.KeyCode.Backspace or k==Enum.KeyCode.Escape then GoBack()
    elseif k==Enum.KeyCode.I then
        if InfoPanel then InfoPanel.Visible=not InfoPanel.Visible end
    end
end)

-- Segurar ↑/↓/←/→: pressionar uma vez = move 1; segurar = move contínuo (WASD não navega)
do
    local hold,rep=0,0
    RunService.Heartbeat:Connect(function(dt)
        if not MS.open or MS.inputOpen or MS.kbOpen then hold=0; rep=0; return end
        local u  = UserInputService:IsKeyDown(Enum.KeyCode.Up)
        local dn = UserInputService:IsKeyDown(Enum.KeyCode.Down)
        local lt = UserInputService:IsKeyDown(Enum.KeyCode.Left)
        local rt = UserInputService:IsKeyDown(Enum.KeyCode.Right)
        if u or dn or lt or rt then
            rep=rep+dt
            if rep >= 0.10 then
                rep=0
                if u then NavUp() elseif dn then NavDown() elseif lt then NavLeft() elseif rt then NavRight() end
            end
        else rep=0 end
    end)
end


