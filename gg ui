local function MkF(p,par)
    local f=Instance.new("Frame") f.BorderSizePixel=0
    for k,v in pairs(p) do
        if k=="radius" then Instance.new("UICorner",f).CornerRadius=UDim.new(0,v)
        elseif k=="stroke" then
            local s=Instance.new("UIStroke",f)
            s.Color=v.c or RGBC s.Thickness=v.t or 1.5
            if v.tr then s.Transparency=v.tr end
            if v.reg then Reg(s,"Color") end
        else pcall(function() f[k]=v end) end
    end
    if par then f.Parent=par end return f
end
local function MkL(p,par)
    local l=Instance.new("TextLabel") l.BackgroundTransparency=1
    for k,v in pairs(p) do pcall(function() l[k]=v end) end
    if par then l.Parent=par end return l
end

