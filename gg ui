--[[

  SINTAXE GERAL:
      AddItem(TAB, "TIPO", "NOME", VALOR, EXTRA, CALLBACK)

  ┌─────────────┬──────────────────────────────────────────────────────┐
  │ TIPO        │ DESCRIÇÃO                                            │
  ├─────────────┼──────────────────────────────────────────────────────┤
  │ "action"    │ Botão clicável                                       │
  │ "toggle"    │ Liga/desliga (true/false)                            │
  │ "slider"    │ Número ajustável com slider                          │
  │ "display"   │ Texto separador visual (não clicável)                │
  │ "submenu"   │ Abre outro menu ao clicar                            │
  └─────────────┴──────────────────────────────────────────────────────┘

  ── action ──
      AddItem(mMisc, "action", "Meu Botão", function()
          -- código que roda ao clicar
      end)

  ── toggle ──
      AddItem(mMisc, "toggle", "Meu Toggle", State.MinhaFlag, function(v)
          State.MinhaFlag = v
          -- v = true (ligado) ou false (desligado)
      end)

  ── slider ──
      AddItem(mMisc, "slider", "Meu Slider", State.MeuValor, 1, function(v)
          State.MeuValor = math.floor(v)
      end)

  ── display ──
      AddItem(mMisc, "display", "── Título da Seção ──")
      -- Apenas texto visual, sem interação

  ── submenu ──
      local mSub = NewMenu("Nome", "Descrição do sub")
      do
          AddItem(mSub, "action", "Botão dentro", function() end)
      end
      AddItem(mMisc, "submenu", "📂 Abrir Sub", mSub)

]]

