-- ==================== PARSER DE COMANDOS ====================
local function parseCommand(input)
    input = input:match("^%s*(.-)%s*$")  -- trim
    if input == "" then return end

    local parts = {}; for word in input:gmatch("%S+") do table.insert(parts, word) end
    if #parts == 0 then return end

    local name = parts[1]:lower(); local args = {}
    for i = 2, #parts do table.insert(args, parts[i]) end

    local cmd = CommandList[name]
    if cmd then
        local ok, err = pcall(cmd.func, args)
        if not ok then Notify("Erro no comando", tostring(err), "error") end
    else
        Notify("Comando inválido", "'"..name.."' não existe. Use ;cmds", "error")
    end
end

