                distColor = Color3.fromRGB(0, 255, 80)
            elseif dist3d < 150 then
                distColor = Color3.fromRGB(255, 200, 0)
            else
                distColor = Color3.fromRGB(255, 50, 50)
            end
            if obj.Box2D then obj.Box2D.Color = distColor end
        end

        -- Skeleton real com Drawing lines
        if State.ESP_Skeleton and obj.SkelLines then
            local char = player.Character
            for _, s in ipairs(obj.SkelLines) do
                local fromPart = char:FindFirstChild(s.from)
                local toPart   = char:FindFirstChild(s.to)
                if fromPart and toPart then
                    local sp1, on1 = WorldToScreen(fromPart.Position)
                    local sp2, on2 = WorldToScreen(toPart.Position)
                    if on1 and on2 then
                        s.line.Visible = true
                        s.line.From = sp1
                        s.line.To   = sp2
                        if State.ESP_ColorDist and distColor then
                            s.line.Color = distColor
                        else
                            s.line.Color = Color3.fromRGB(0, 255, 200)
                        end
                    else
                        s.line.Visible = false
                    end
                else
                    s.line.Visible = false
                end
            end
        elseif obj.SkelLines then
            for _, s in ipairs(obj.SkelLines) do s.line.Visible = false end
        end
    end

    -- NPC ESP
    if State.ESP_NPC then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("Model") and v ~= LocalPlayer.Character then
                local hum = v:FindFirstChildOfClass("Humanoid")
                local hrp = v:FindFirstChild("HumanoidRootPart")
                if hum and hrp and not Players:GetPlayerFromCharacter(v) then
                    local key = v
                    if not NPCObjects[key] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 200, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 200, 0)
                        hl.FillTransparency = 0.7
                        hl.Adornee = v
                        hl.Parent = PlayerGui
                        local bb = Instance.new("BillboardGui")
                        bb.StudsOffset = Vector3.new(0, 3, 0)
                        bb.AlwaysOnTop = true
                        bb.Size = UDim2.new(0, 120, 0, 20)
                        bb.Adornee = hrp
                        bb.Parent = PlayerGui
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.fromScale(1, 1)
                        lbl.BackgroundTransparency = 1
                        lbl.TextColor3 = Color3.fromRGB(255, 200, 0)
                        lbl.Text = "NPC: " .. v.Name
                        lbl.TextSize = 12
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextStrokeTransparency = 0.5
                        lbl.Parent = bb
                        NPCObjects[key] = {Highlight=hl, Billboard=bb}
                    end
                end
            end
        end
    else
        for k, v in pairs(NPCObjects) do
            if v.Highlight then v.Highlight:Destroy() end
            if v.Billboard then v.Billboard:Destroy() end
            NPCObjects[k] = nil
        end
    end

    -- Spawn Points ESP
    if State.ESP_SpawnPoints then
        for _, v in ipairs(Workspace:GetDescendants()) do
            if v:IsA("SpawnLocation") then
                if not v:FindFirstChild("_GGSpawnHL") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "_GGSpawnHL"
                    hl.FillColor = Color3.fromRGB(0, 200, 255)
                    hl.OutlineColor = Color3.fromRGB(0, 200, 255)
                    hl.FillTransparency = 0.5
                    hl.Adornee = v
                    hl.Parent = PlayerGui
                end
            end
        end
    else
        for _, v in ipairs(PlayerGui:GetChildren()) do
            if v.Name == "_GGSpawnHL" then v:Destroy() end
        end
    end
