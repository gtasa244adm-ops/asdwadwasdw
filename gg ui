                obj.HPBar.Color=Color3.fromRGB(math.floor(255*(1-pct)),math.floor(255*pct),0)
            else
                obj.HPBar.Color=Color3.fromRGB(0,255,80)
            end
        elseif obj.HPBar then
            obj.HPBar.Visible=false; obj.HPBg.Visible=false
        end

        -- ── Tracer Line ──
        if State.ESP_Lines and show and onScreen and obj.Line then
            obj.Line.Visible=true; obj.Line.Color=espColor
            obj.Line.From=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
