-- Obter melhor alvo
local function GetAimbotTarget()
    local vp = Camera.ViewportSize
    local refPoint = State.AimbotMode=="Center" and vp/2 or Vector2.new(Mouse.X,Mouse.Y)
    local fov = State.AimbotFOV

    -- Multi-lock: mantém alvo se ainda vivo e no FOV
    if State.MultiTargetLock and LastLockedTarget then
        local lt = LastLockedTarget
        local alive = lt.player and IsAlive(lt.player)
            or (not lt.player and (function()
                local ch=lt.getChar(); local h=ch and ch:FindFirstChildOfClass("Humanoid")
                return h and h.Health>0
            end)())
        if alive then
            local bp = lt.getPos()
            if bp then
                local sp,on = WorldToScreen(bp)
                if on and (sp-refPoint).Magnitude < fov*1.3 then return lt end
            end
        end
        if State.AutoSwapTarget then Notify("🎯 Aimbot","Alvo morreu, trocando...",1) end
        LastLockedTarget = nil
    end

    local best, bestDist = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        if not IsAlive(p) then continue end
        if State.AimbotTeamCheck and not IsEnemy(p) then continue end

        local bp = GetBestBone(p)
        if not bp then continue end
        local sp, on = WorldToScreen(bp)
        if not on then continue end

        local c = GetCharacter(p)
        if State.AimbotWallCheck and not State.AutoWall then
            if not WallCheckClear(bp,c) then continue end
        elseif State.AutoWall then
            if not AutoWallCheck(bp,c) then continue end
        end
        if State.AimbotVisible then
            if not IsVisibleCached(p, tick()) then continue end
        end

        local d = (sp-refPoint).Magnitude
        if d < fov and d < bestDist then
            bestDist=d
            local pl=p
            best={player=pl, isNPC=false,
                getPos=function() return GetBestBone(pl) end,
                getChar=function() return GetCharacter(pl) end}
        end
    end

    if State.AimbotNPC then
        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model") and model~=LocalPlayer.Character then
                if Players:GetPlayerFromCharacter(model) then continue end
                local nh=model:FindFirstChildOfClass("Humanoid")
                local nr=model:FindFirstChild("HumanoidRootPart")
                if not(nh and nr and nh.Health>0) then continue end
                local head=model:FindFirstChild("Head") or nr
                local sp,on=WorldToScreen(head.Position)
                if not on then continue end
                local d=(sp-refPoint).Magnitude
                if d<fov and d<bestDist then
                    bestDist=d
                    local m=model
                    best={player=nil,isNPC=true,
                        getPos=function() local h=m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart") return h and h.Position end,
                        getChar=function() return m end}
                end
            end
        end
    end

    if State.MultiTargetLock then LastLockedTarget=best end
    return best
end

