-- Humanize
local function UpdateHumanize(dt)
    if not State.AimbotHumanize then HumanizeOffset=Vector2.new(0,0); return end
    HumanizeTimer = HumanizeTimer + dt*2
    local str = math.clamp((State.HumanizeStrength or 50)/100*12,0.1,12)
    local nx = math.sin(HumanizeTimer*1.3)*math.cos(HumanizeTimer*0.7)*str
    local ny = math.cos(HumanizeTimer*1.1)*math.sin(HumanizeTimer*0.9)*str
    HumanizeOffset = HumanizeOffset:Lerp(Vector2.new(nx,ny),0.15)
end

-- Aimbot principal
_G.GGBlock.aimCamSaved = false

local function UpdateAimbot(dt)
    local vp = Camera.ViewportSize
    local ref = State.AimbotMode=="Center" and vp/2 or Vector2.new(Mouse.X,Mouse.Y)

    if AimbotFOVCircle then
        AimbotFOVCircle.Visible = State.Aimbot and State.AimbotShowFOV
        AimbotFOVCircle.Position = ref
        AimbotFOVCircle.Radius   = State.AimbotFOV
        AimbotFOVCircle.Color    = State.AimbotLock and Color3.fromRGB(255,40,40)
            or (LastLockedTarget and Color3.fromRGB(255,165,0))
            or RGBC
    end

    UpdateHumanize(dt)

    if not State.Aimbot then SetCamScriptable(false); return end
    if State.AimbotKey and not AimKeyHeld then SetCamScriptable(false); return end
    if State.WeaponOnly then
        local ch=LocalPlayer.Character; local hw=false
        if ch then for _,v in ipairs(ch:GetChildren()) do if v:IsA("Tool") then hw=true; break end end end
        if not hw then SetCamScriptable(false); return end
    end

    -- SilentAim: não move câmera, só redireciona Mouse.Hit (já feito no SetupSilentAim)
    if State.SilentAim then SetCamScriptable(false); return end

    local target = GetAimbotTarget()
    if not target then SetCamScriptable(false); return end

    local bp = target.getPos()
    if not bp then SetCamScriptable(false); return end

    -- Ativa modo Scriptable apenas quando há alvo
    SetCamScriptable(true)

    local predicted = (target.player and not target.isNPC)
        and GetPredictedPosition(target.player, bp) or bp

    -- Smooth frame-rate independente via dt
    local baseSmooth
    if State.AimbotLock then
        baseSmooth = 1.0
    elseif State.FlickMode then
        baseSmooth = 0.95
    else
        -- range: 0.05 (lento) a 0.90 (rápido)
        baseSmooth = math.clamp((State.AimbotSmooth or 75)/100*0.85+0.05, 0.05, 0.90)
    end
    -- Compensação de frame-rate: mesma velocidade em 30 ou 144fps
    local dtSmooth = 1 - (1-baseSmooth)^(dt/0.016)

    local targetCF = CFrame.lookAt(Camera.CFrame.Position, predicted)
    if State.AimbotHumanize and not State.AimbotLock then
        targetCF = targetCF * CFrame.Angles(
            math.rad(HumanizeOffset.Y*0.5), math.rad(HumanizeOffset.X*0.5), 0)
    end

    pcall(function()
        Camera.CFrame = Camera.CFrame:Lerp(targetCF * AimShakeOffset, dtSmooth)
    end)
end




