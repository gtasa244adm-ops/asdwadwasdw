local _SKEL_R15 = {
    {"Head","UpperTorso"},
    {"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local _SKEL_R6 = {
    {"Head","Torso"},
    {"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},
}

local function IsVisibleCached(player, now)
    local t = _espThrottle[player]
    if not t then t = {}; _espThrottle[player] = t end
    -- raycast só a cada 120ms
    if t.lastVisT and (now - t.lastVisT) < 0.12 then return t.isVis end
    t.lastVisT = now
    local hrp = GetHRP(player)
    if not hrp then t.isVis = false; return false end
    local origin = Camera.CFrame.Position
    local dir = (hrp.Position - origin)
    _espRPParams.FilterDescendantsInstances = {LocalPlayer.Character, Workspace.Terrain}
    local result = Workspace:Raycast(origin, dir.Unit * math.min(dir.Magnitude, 2000), _espRPParams)
    local vis = (not result) or (result.Instance and result.Instance:IsDescendantOf(player.Character))
    t.isVis = vis
    return vis
end

local function GetInfoTextCached(player, hum, hrp, now)
    local t = _espThrottle[player]
    if not t then t = {}; _espThrottle[player] = t end
    -- texto só atualiza a cada 100ms
    if t.lastInfoT and (now - t.lastInfoT) < 0.10 and t.infoText then
        return t.infoText
    end
    t.lastInfoT = now
    local lines = {}
    if State.ESP_Distance then
        local d = GetDistance(player)
        if State.ESP_DistanceMeter then
            table.insert(lines, "📍 "..d.." st / "..math.floor(d*0.28).." m")
        else
            table.insert(lines, "📍 "..d.." studs")
        end
    end
    if State.ESP_Health then
        local hp = math.floor(hum.Health); local mx = math.max(math.floor(hum.MaxHealth),1)
        table.insert(lines, "❤ "..hp.."/"..mx)
    end
    if State.ESP_Tool then
        local items = {}
        local bp = player:FindFirstChild("Backpack")
        if bp then for _,v in ipairs(bp:GetChildren()) do if v:IsA("Tool") then table.insert(items,v.Name) end end end
        if player.Character then for _,v in ipairs(player.Character:GetChildren()) do if v:IsA("Tool") then table.insert(items,"["..v.Name.."]") end end end
        table.insert(lines, "🎒 "..(#items>0 and table.concat(items,", ") or "Empty"))
    end
    if State.ESP_Speed then table.insert(lines,"⚡ "..math.floor(hum.WalkSpeed).." ws") end
    if State.ESP_Status then
        local status = hum.MoveDirection.Magnitude>0.1 and "🏃 Moving" or "🧍 Idle"
        if hum.Health<=0 then status="💀 Dead" end
        table.insert(lines, status)
    end
    if State.ESP_Visible then
        local vis = IsVisibleCached(player, now)
        table.insert(lines, vis and "👁 Visible" or "🚫 Hidden")
    end
    t.infoText = table.concat(lines,"\n")
    return t.infoText
end

local function CreateESPForPlayer(player)
    if ESPObjects[player] then return end
    local obj = {}

    local highlight = Instance.new("Highlight")
    highlight.FillTransparency = 0.7; highlight.OutlineTransparency = 0
    highlight.Adornee = nil; highlight.Parent = PlayerGui
    obj.Highlight = highlight

    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0,200,0,120); billboard.StudsOffset = Vector3.new(0,3,0)
    billboard.AlwaysOnTop = true; billboard.MaxDistance = 1000
    billboard.Enabled = false; billboard.Parent = PlayerGui
    local nameLabel = Instance.new("TextLabel")
    nameLabel.Size = UDim2.new(1,0,0,18); nameLabel.BackgroundTransparency = 1
    nameLabel.TextColor3 = Color3.fromRGB(255,255,255); nameLabel.TextSize = 14
    nameLabel.Font = Enum.Font.GothamBold; nameLabel.Text = player.Name
    nameLabel.TextStrokeTransparency = 0.5; nameLabel.Parent = billboard
    obj.NameLabel = nameLabel
    local infoLabel = Instance.new("TextLabel")
    infoLabel.Size = UDim2.new(1,0,0,80); infoLabel.Position = UDim2.new(0,0,0,18)
    infoLabel.BackgroundTransparency = 1; infoLabel.TextColor3 = Color3.fromRGB(200,200,200)
    infoLabel.TextSize = 12; infoLabel.Font = Enum.Font.Gotham; infoLabel.Text = ""
    infoLabel.TextYAlignment = Enum.TextYAlignment.Top
    infoLabel.TextStrokeTransparency = 0.5; infoLabel.Parent = billboard
    obj.InfoLabel = infoLabel; obj.Billboard = billboard

    if Drawing then
        local box = Drawing.new("Square"); box.Visible=false
        box.Color=Color3.fromRGB(255,0,100); box.Thickness=1.5; box.Filled=false
        obj.Box2D = box
        local hpBg = Drawing.new("Square"); hpBg.Visible=false
        hpBg.Color=Color3.fromRGB(0,0,0); hpBg.Thickness=1; hpBg.Filled=true
        obj.HPBg = hpBg
        local hpBar = Drawing.new("Square"); hpBar.Visible=false
        hpBar.Color=Color3.fromRGB(0,255,100); hpBar.Thickness=1; hpBar.Filled=true
        obj.HPBar = hpBar
        local line = Drawing.new("Line"); line.Visible=false
        line.Color=Color3.fromRGB(255,255,0); line.Thickness=1
        obj.Line = line
    end

    -- Skeleton: detecta rig uma vez, cria linhas só para o rig correto
    if Drawing then
        local char = player.Character
        local isR15 = char and (char:FindFirstChild("UpperTorso") ~= nil)
        local skelDef = isR15 and _SKEL_R15 or _SKEL_R6
        obj.SkelLines = {}
        obj.SkelIsR15 = isR15
        for i=1,#skelDef do
            local l = Drawing.new("Line"); l.Visible=false
            l.Color=Color3.fromRGB(0,255,200); l.Thickness=1.5
            obj.SkelLines[i] = {line=l, from=skelDef[i][1], to=skelDef[i][2]}
        end
    end

    ESPObjects[player] = obj
end

local function RemoveESPForPlayer(player)
    local obj = ESPObjects[player]
    if not obj then return end
    pcall(function() obj.Highlight:Destroy() end)
    pcall(function() obj.Billboard:Destroy() end)
    if obj.Box2D then obj.Box2D:Remove() end
    if obj.HPBg  then obj.HPBg:Remove() end
    if obj.HPBar then obj.HPBar:Remove() end
    if obj.Line  then obj.Line:Remove() end
    if obj.HitboxSel then pcall(function() obj.HitboxSel:Destroy() end) end
    if obj.SkelLines then for _,s in ipairs(obj.SkelLines) do s.line:Remove() end end
    _espThrottle[player] = nil
    ESPObjects[player] = nil
end

local _anyESP = false  -- cache para evitar checar State todo frame quando tudo está off

local function UpdateESP()
    local now = tick()

    -- Garante que todos jogadores têm objeto ESP
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then CreateESPForPlayer(player) end
    end
    -- Remove jogadores que saíram
    for player in pairs(ESPObjects) do
        if not player.Parent then RemoveESPForPlayer(player) end
    end

    -- Verifica se algum ESP está ativo (cache — evita trabalho extra quando tudo off)
    _anyESP = State.ESP_Names or State.ESP_Distance or State.ESP_Health
        or State.ESP_Tool or State.ESP_Team or State.ESP_Speed
        or State.ESP_Status or State.ESP_Visible or State.ESP_Box2D
        or State.ESP_Box3D or State.ESP_Lines or State.ESP_Skeleton
        or State.ESP_Hitbox or State.ESP_ColorDist

    if not _anyESP and not State.ESP_NPC and not State.ESP_SpawnPoints then
        -- Tudo off: esconde tudo e sai rápido
        for _, obj in pairs(ESPObjects) do
            if obj.Billboard.Enabled then obj.Billboard.Enabled = false end
            if obj.Highlight.Adornee then obj.Highlight.Adornee = nil end
            if obj.Box2D and obj.Box2D.Visible then obj.Box2D.Visible = false end
            if obj.HPBar and obj.HPBar.Visible then obj.HPBar.Visible = false; obj.HPBg.Visible = false end
            if obj.Line  and obj.Line.Visible  then obj.Line.Visible  = false end
        end
    else

    for player, obj in pairs(ESPObjects) do
        local hrp = GetHRP(player)
        local hum = GetHumanoid(player)

        if not hrp or not hum or hum.Health <= 0 then
            obj.Billboard.Enabled = false; obj.Highlight.Adornee = nil
            if obj.Box2D then obj.Box2D.Visible = false end
            if obj.HPBar then obj.HPBar.Visible = false; obj.HPBg.Visible = false end
            if obj.Line  then obj.Line.Visible  = false end
            if obj.SkelLines then for _,s in ipairs(obj.SkelLines) do s.line.Visible=false end end
            continue
        end

        -- Filtros de time
        local show = true
        if State.ESP_EnemyOnly and not IsEnemy(player) then show = false end
        if State.ESP_AllyOnly  and IsEnemy(player)     then show = false end

        -- Visibilidade (throttled, só rayo a cada 120ms)
        local isVis = (State.ESP_WallColor or State.ESP_Visible) and IsVisibleCached(player, now) or true

        -- Cor base
        local espColor
        if State.ESP_ColorDist then
            local d = GetDistance(player)
