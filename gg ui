        -- ── HP Bar ──
        if State.ESP_Health and (State.ESP_HealthColor or State.ESP_Box2D) and onScreen and obj.HPBar then
            local h = math.clamp(2000/depth,20,400); local w = h*0.6
            local pct = math.clamp(hum.Health/math.max(hum.MaxHealth,1),0,1)
            obj.HPBg.Visible=true; obj.HPBar.Visible=true
            obj.HPBg.Size=Vector2.new(4,h)
