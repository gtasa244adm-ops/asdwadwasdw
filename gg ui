local function populateCmds(filter)
    filter = (filter or ""):lower()
    for _, ch in ipairs(CmdsScroll:GetChildren()) do if ch:IsA("Frame") then ch:Destroy() end end

    local count = 0
    for _, cmd in ipairs(CommandInfos) do
        local matchName = cmd.names[1]:lower():find(filter, 1, true)
        local matchDesc = cmd.desc:lower():find(filter, 1, true)
        if filter == "" or matchName or matchDesc then
            count = count + 1
            local entry = Instance.new("Frame", CmdsScroll)
            entry.Size = UDim2.new(1, 0, 0, 56)
            entry.BackgroundColor3 = count%2 == 0 and THEME.bg or Color3.fromRGB(16,16,16)
            entry.BorderSizePixel = 0; entry.LayoutOrder = count

