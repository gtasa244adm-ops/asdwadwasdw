-- ════════════════════════════════════════════════════════════
--  🎒 RODA SECRETA DE PACKS (sobrepõe a roda, BtnChange abre/fecha)
--     • As setas ◀ ▶ não chegam aqui
--     • Cada botão = um pack completo (aplica tudo de uma vez)
--     • Botão central = 🔄 Normal (reseta para anim padrão)
-- ════════════════════════════════════════════════════════════
local packOverlayFrame = nil
local packOverlayOpen  = false

local function refreshPackLabel()
    if PackLabel and PackLabel.Parent then
        if currentAnimPackIdx == 0 then
            PackLabel.Text = "🎒 Normal"
        else
            PackLabel.Text = "🎒 " .. getAnimPack().packName
        end
    end
end

local function applyPackByIdx(idx)
    if idx == 0 then
        -- reseta para animações originais do Roblox
        originalMoveAnims = {}
        local char = Player.Character
        if char then
            resetMoveAnims(char)
        end
        currentAnimPackIdx = 0
    else
        currentAnimPackIdx = idx
        originalMoveAnims  = {}
        local char = Player.Character
        if char then
            applyMoveAnims(char)
        end
    end
    refreshPackLabel()
end

local function buildPackOverlay(wheel)
    local old = wheel:FindFirstChild("CEW_PackOverlay")
    if old then old:Destroy() end

    -- Frame de fundo cobre a roda inteira
    local frame = Instance.new("Frame")
    frame.Name                   = "CEW_PackOverlay"
    frame.Size                   = UDim2.new(1, 0, 1, 0)
    frame.Position               = UDim2.new(0, 0, 0, 0)
    frame.BackgroundColor3       = Color3.fromRGB(0, 0, 0)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel        = 0
    frame.ZIndex                 = 20
    frame.Visible                = false
    frame.Parent                 = wheel
    local fC = Instance.new("UICorner"); fC.CornerRadius = UDim.new(1, 0); fC.Parent = frame

    -- Label central "Escolha o Pack"
    local centerBg = Instance.new("Frame")
    centerBg.Size                   = UDim2.new(0.34, 0, 0.34, 0)
    centerBg.Position               = UDim2.new(0.33, 0, 0.33, 0)
    centerBg.BackgroundColor3       = Color3.fromRGB(12, 12, 28)
    centerBg.BackgroundTransparency = 0.08
    centerBg.BorderSizePixel        = 0
    centerBg.ZIndex                 = 21
    centerBg.Parent                 = frame
    local cbC = Instance.new("UICorner"); cbC.CornerRadius = UDim.new(1, 0); cbC.Parent = centerBg
    local cbS = Instance.new("UIStroke"); cbS.Color = Color3.fromRGB(100, 100, 255); cbS.Thickness = 1.5; cbS.Parent = centerBg

    -- Botão central = Normal (reseta)
    local centerBtn = Instance.new("TextButton")
    centerBtn.Size                   = UDim2.new(1, 0, 1, 0)
    centerBtn.BackgroundTransparency = 1
    centerBtn.Text                   = "🔄\nNormal"
    centerBtn.TextColor3             = Color3.fromRGB(220, 220, 255)
    centerBtn.TextScaled             = true
    centerBtn.Font                   = Enum.Font.GothamBold
    centerBtn.ZIndex                 = 22
    centerBtn.AutoButtonColor        = false
    centerBtn.Parent                 = centerBg
    centerBtn.MouseButton1Click:Connect(function()
        applyPackByIdx(0)
        packOverlayOpen  = false
        frame.Visible    = false
        Notify({ Title = "🔄 Normal", Content = "Animações padrão restauradas!", Duration = 3 })
    end)

    -- Botões dos packs em círculo
    -- distribui N packs igualmente em volta, começando do topo (-90°)
    local total = #ANIM_PACKS
    local r  = 0.33  -- raio (relativo ao frame 1x1)
    local bW = 0.22
    local bH = 0.14

    for i, pack in ipairs(ANIM_PACKS) do
        local angle = -90 + (360 / total) * (i - 1)
        local rad   = math.rad(angle)
        local cx    = 0.5 + r * math.cos(rad) - bW / 2
        local cy    = 0.5 + r * math.sin(rad) - bH / 2

        local isActive = (currentAnimPackIdx == i)

        local btn = Instance.new("TextButton")
        btn.Size                   = UDim2.new(bW, 0, bH, 0)
        btn.Position               = UDim2.new(cx, 0, cy, 0)
        btn.BackgroundColor3       = isActive and Color3.fromRGB(30,70,130) or Color3.fromRGB(12,12,30)
        btn.BackgroundTransparency = 0.08
        btn.BorderSizePixel        = 0
        btn.Text                   = pack.packName
        btn.TextColor3             = Color3.fromRGB(230, 230, 255)
        btn.TextScaled             = true
        btn.Font                   = Enum.Font.GothamBold
        btn.ZIndex                 = 22
        btn.AutoButtonColor        = false
        btn.Parent                 = frame
        local bC = Instance.new("UICorner"); bC.CornerRadius = UDim.new(0, 10); bC.Parent = btn
        local bS = Instance.new("UIStroke")
        bS.Color     = isActive and Color3.fromRGB(100, 160, 255) or Color3.fromRGB(70, 70, 180)
        bS.Thickness = 1.3
        bS.Parent    = btn

        btn.MouseEnter:Connect(function()
            if currentAnimPackIdx ~= i then btn.BackgroundColor3 = Color3.fromRGB(28,28,60) end
        end)
        btn.MouseLeave:Connect(function()
            if currentAnimPackIdx ~= i then btn.BackgroundColor3 = Color3.fromRGB(12,12,30) end
        end)

        local capturedIdx = i
        btn.MouseButton1Click:Connect(function()
            applyPackByIdx(capturedIdx)
            packOverlayOpen = false
            frame.Visible   = false
        end)
    end

    -- Botão ✕ fechar (canto superior direito)
    local closeBtn = Instance.new("TextButton")
    closeBtn.Size                   = UDim2.new(0.10, 0, 0.10, 0)
    closeBtn.Position               = UDim2.new(0.79, 0, 0.06, 0)
    closeBtn.BackgroundColor3       = Color3.fromRGB(170, 25, 25)
    closeBtn.BackgroundTransparency = 0.15
    closeBtn.BorderSizePixel        = 0
    closeBtn.Text                   = "✕"
    closeBtn.TextColor3             = Color3.fromRGB(255, 255, 255)
    closeBtn.TextScaled             = true
    closeBtn.Font                   = Enum.Font.GothamBold
    closeBtn.ZIndex                 = 23
    closeBtn.Parent                 = frame
    local clC = Instance.new("UICorner"); clC.CornerRadius = UDim.new(1, 0); clC.Parent = closeBtn
    closeBtn.MouseButton1Click:Connect(function()
        packOverlayOpen = false
        frame.Visible   = false
    end)

    packOverlayFrame = frame
    return frame
end

local function togglePackOverlay()
    local wheel = getWheel()
    if not wheel then return end

    -- reconstrói sempre para refletir o pack ativo atual
    buildPackOverlay(wheel)

    packOverlayOpen = not packOverlayOpen
    if packOverlayFrame then
        packOverlayFrame.Visible = packOverlayOpen
    end
    if packOverlayOpen then
        Notify({ Title = "🎒 Packs", Content = "Escolha o pack ou toque em Normal", Duration = 3 })
    end
end

