-- ════════════════════════════════════════════════════════════
local function syncColors()
    local ov = getOverlay()
    if not ov then return end
    local col = ov.BackgroundColor3
    local tr  = ov.BackgroundTransparency
    local function sf(f) if f and f.Parent then f.BackgroundColor3=col; f.BackgroundTransparency=tr end end
    local function st(l) if l and l.Parent then l.TextColor3=col; l.TextTransparency=tr end end
    sf(TopBar); sf(UnderBar)
    sf(BtnWalk); sf(BtnFav); sf(BtnSpeed); sf(BtnChange); sf(BtnReload); sf(SpeedBox)
    st(TabLabel); st(TabCounter)
end

