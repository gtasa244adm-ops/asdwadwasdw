    local drag,ds,sp=false,nil,nil
    mBtn.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.Touch then
            drag=true; ds=i.Position; sp=mBtn.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then drag=false end end)
        end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if drag and i.UserInputType==Enum.UserInputType.Touch then
            local d=i.Position-ds
            mBtn.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
        end
    end)
    mBtn.MouseButton1Click:Connect(function()
        local ok,w=pcall(function() return CoreGui.RobloxGui.EmotesMenu.Children.Main.EmotesWheel end)
        GuiService:SetEmotesMenuOpen(ok and w and not w.Visible or true)
    end)
    RunService.Heartbeat:Connect(function()
        local ok,w=pcall(function() return CoreGui.RobloxGui.EmotesMenu.Children.Main.EmotesWheel end)
        mBtn.Visible=not(ok and w and w.Visible)
    end)
    Notify({ Title="📱 Mobile", Content="Botão adicionado — arraste para mover", Duration=5 })
end

