end

local function loadFavorites()
    if readfile and isfile and isfile(favFile) then
        local ok, r = pcall(function() return HttpService:JSONDecode(readfile(favFile)) end)
        if ok and r then favoriteEmotes = r end
    end
end

local function isInFav(id)
    for _, f in pairs(favoriteEmotes) do if f.id == tostring(id) then return true end end
    return false
end

local function extractId(url)
    return url:match("Asset&id=(%d+)")
end

local function updateFavIcon(imgLbl, id)
    local fi = imgLbl:FindFirstChild("FavIcon")
    if not fi then
        fi = Instance.new("ImageLabel")
        fi.Name = "FavIcon"; fi.Size = UDim2.new(0.3,0,0.3,0)
        fi.Position = UDim2.new(0.7,0,0,0)
        fi.BackgroundTransparency = 1; fi.ZIndex = imgLbl.ZIndex + 5
        fi.ScaleType = Enum.ScaleType.Fit; fi.Parent = imgLbl
    end
    fi.Image = isInFav(id) and IMG_FAV_ON or IMG_FAV_OFF
end

local function stopFavDetection()
    isMonitorFav = false
    for _, c in pairs(favClickConns) do if c then pcall(function() c:Disconnect() end) end end
    favClickConns = {}
    local front = getFront()
    if front then
        for _, ch in pairs(front:GetChildren()) do
            if ch:IsA("ImageLabel") then
                local cd = ch:FindFirstChild("FavCD"); if cd then cd:Destroy() end
                local fi = ch:FindFirstChild("FavIcon"); if fi then fi:Destroy() end
            end
        end
    end
end

local function setupFavDetection()
    if isMonitorFav then return end
    isMonitorFav = true
    task.spawn(function()
        while favoriteEnabled do
            local front = getFront()
            if front then
                for _, c in pairs(favClickConns) do if c then pcall(function() c:Disconnect() end) end end
                favClickConns = {}
                for _, ch in pairs(front:GetChildren()) do
                    if ch:IsA("ImageLabel") and ch.Image ~= "" then
                        local assetId = extractId(ch.Image)
                        if assetId then
                            updateFavIcon(ch, assetId)
                            local cd = ch:FindFirstChild("FavCD")
                            if not cd then
                                cd = Instance.new("TextButton")
                                cd.Name = "FavCD"; cd.Size = UDim2.new(1,0,1,0)
                                cd.BackgroundTransparency = 1; cd.Text = ""
                                cd.ZIndex = ch.ZIndex + 8; cd.Parent = ch
                            end
                            local conn = cd.MouseButton1Click:Connect(function()
                                if not favoriteEnabled then return end
                                local numId = tonumber(assetId)
                                local eName = (numId and nameCache[numId]) or ("ID:"..assetId)
                                local found, fi2 = false, 0
                                for i, fv in pairs(favoriteEmotes) do
                                    if fv.id == assetId then found=true; fi2=i; break end
                                end
                                if found then
                                    table.remove(favoriteEmotes, fi2)
                                    Notify({ Title="⭐ Favorito", Content='🗑️ "'..eName..'" removido', Duration=3 })
                                else
                                    table.insert(favoriteEmotes, { id=assetId, name=eName })
                                    Notify({ Title="⭐ Favorito", Content='✅ "'..eName..'" adicionado', Duration=3 })
                                end
                                saveFavorites()
                                updateFavIcon(ch, assetId)
                            end)
                            table.insert(favClickConns, conn)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
        stopFavDetection()
        isMonitorFav = false
    end)
end

