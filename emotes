local function stopCurrentEmote()
    if currentEmoteTrack then
        pcall(function() currentEmoteTrack:Stop() end)
        currentEmoteTrack = nil
    end
end

local function stopAllEmotes()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    for _, t in ipairs(hum:GetPlayingAnimationTracks()) do
        pcall(function() t:Stop() end)
    end
end

-- ════════════════════════════════════════════════════════════
--  ✅ FORÇA PLAY DO EMOTE (método direto pelo Animator)
--
--  Não depende do sistema nativo de emotes do Roblox.
--  Carrega a animação diretamente e toca com prioridade máxima.
-- ════════════════════════════════════════════════════════════
local function forcePlayEmote(emoteId, looped)
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChild("Animator")
    if not animator then return end

    stopCurrentEmote()
    stopAllEmotes()

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. tostring(emoteId)

    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    if not ok or not track then
        Notify({ Title = "❌ Erro", Content = "Falha ao carregar emote ID: " .. tostring(emoteId), Duration = 3 })
        return
    end

    currentEmoteTrack          = track
    currentEmoteTrack.Priority = Enum.AnimationPriority.Action4
    currentEmoteTrack.Looped   = looped ~= false

    currentEmoteTrack:Play()

    if speedEmoteEnabled and SpeedBox then
        currentEmoteTrack:AdjustSpeed(tonumber(SpeedBox.Text) or 1)
    end

    getgenv().lastPlayedEmoteId = emoteId
end

-- ════════════════════════════════════════════════════════════
--  CONEXÕES DE CLIQUE NOS BOTÕES DA RODA (força o play)
--
--  Substitui o comportamento nativo: quando o usuário clica
--  em um slot da roda, o script intercepta e força o emote.
-- ════════════════════════════════════════════════════════════
local emoteSlotConns = {}
local lastInjectedIds = {}

local function connectEmoteSlots()
    -- desconecta anteriores
    for _, c in pairs(emoteSlotConns) do
        if c then pcall(function() c:Disconnect() end) end
    end
    emoteSlotConns = {}

    local front = getFront()
    if not front then return end

    local tab = TABS[currentTab]
    local slotIndex = 0

    -- os filhos ImageLabel dentro de EmotesButtons correspondem aos slots
    local buttons = {}
    for _, child in pairs(front:GetChildren()) do
        if child:IsA("ImageLabel") then
            table.insert(buttons, child)
        end
    end

    -- ordena por LayoutOrder ou Name para garantir a ordem correta
    table.sort(buttons, function(a, b)
        return (a.LayoutOrder or 0) < (b.LayoutOrder or 0)
    end)

    for i, imgLabel in ipairs(buttons) do
        local id = tab.ids[i]
        if id and id ~= 0 then
            -- cria ou reutiliza TextButton invisível por cima
            local btn = imgLabel:FindFirstChild("CEW_Slot")
            if not btn then
                btn = Instance.new("TextButton")
                btn.Name = "CEW_Slot"
                btn.Size = UDim2.new(1,0,1,0)
                btn.BackgroundTransparency = 1
                btn.Text = ""
                btn.ZIndex = imgLabel.ZIndex + 10
                btn.Parent = imgLabel
            end

            local capturedId = id
            local conn = btn.MouseButton1Click:Connect(function()
                if favoriteEnabled then return end -- deixa o modo favorito agir
                forcePlayEmote(capturedId)
                Notify({
                    Title   = "🎭 " .. (nameCache[capturedId] or "Emote"),
                    Content = "Emote iniciado!",
                    Duration = 2
                })
            end)
            table.insert(emoteSlotConns, conn)
        else
            -- slot vazio: remove botão se existir
            local btn = imgLabel:FindFirstChild("CEW_Slot")
            if btn then btn:Destroy() end
        end
    end
end

-- ════════════════════════════════════════════════════════════
--  INJETAR ABA ATUAL NA RODA (SetEmotes + SetEquippedEmotes)
-- ════════════════════════════════════════════════════════════
local function injectCurrentTab()
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    if not hum then return end

    if hum.RigType == Enum.HumanoidRigType.R6 then
        Notify({ Title = "⚠️", Content = "R6 não suportado. Use R15.", Duration = 5 })
        return
    end

    local hd = hum:FindFirstChildOfClass("HumanoidDescription")
    if not hd then hd = hum.HumanoidDescription end
    if not hd then return end

    local tab        = TABS[currentTab]
    local emoteTable = {}
    local equipped   = {}

    for i = 1, math.min(#tab.ids, 8) do
        local id = tab.ids[i]
        if id and id ~= 0 then
            local name = nameCache[id] or ("Emote" .. i)
            -- garante unicidade
            local finalName = name
            local count = 0
            while emoteTable[finalName] do
                count += 1
                finalName = name .. "_" .. count
            end
            emoteTable[finalName] = { id }
            equipped[i]           = finalName
        end
    end

    pcall(function()
        hd:SetEmotes(emoteTable)
        hd:SetEquippedEmotes(equipped)
    end)

    -- salva os IDs que foram injetados
    lastInjectedIds = {}
    for i, id in ipairs(tab.ids) do
        lastInjectedIds[i] = id
    end

    -- conecta cliques diretos nos slots após breve delay
    task.delay(0.3, connectEmoteSlots)
end

