local function makeBtn(parent, name, pos, size, img, zIdx)
    local b = Instance.new("ImageButton")
    b.Name = name; b.Parent = parent
    b.BackgroundColor3 = Color3.fromRGB(0,0,0)
    b.BackgroundTransparency = 0.4; b.BorderSizePixel = 0
    b.Position = pos; b.Size = size; b.Image = img; b.ZIndex = zIdx or 2
    local c = Instance.new("UICorner"); c.CornerRadius=UDim.new(0,10); c.Parent=b
    return b
end

