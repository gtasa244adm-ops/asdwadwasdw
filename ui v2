        pcall(function() t.a1:Destroy() end)
        pcall(function() t.tr:Destroy() end)
    end
    activeTrails={}
end

V.SetupTrail = function()
    destroyTrails()
    if not State.TrailEnabled then return end
    local char=LocalPlayer.Character; if not char then return end
    local half    = math.clamp((State.TrailWidth or 10)/100*1.5, 0.05, 2)
    local lifetime= math.clamp((State.TrailLifetime or 50)/100*3, 0.1, 3)
    local transp  = math.clamp((State.TrailTransp or 0)/100, 0, 0.95)
    for pn,sel in pairs(V.TrailSelectedParts) do
        if not sel then continue end
        local part=char:FindFirstChild(pn)
        if not part or not part:IsA("BasePart") or pn=="HumanoidRootPart" then continue end
        local a0=Instance.new("Attachment"); a0.Position=Vector3.new(0,half,0);  a0.Parent=part
        local a1=Instance.new("Attachment"); a1.Position=Vector3.new(0,-half,0); a1.Parent=part
        local tr=Instance.new("Trail")
        tr.Attachment0=a0; tr.Attachment1=a1; tr.Lifetime=lifetime
        tr.MinLength=0; tr.FaceCamera=true
        tr.Color=getTrailCol(); tr.Transparency=NumberSequence.new(transp); tr.Parent=part
        activeTrails[pn]={a0=a0,a1=a1,tr=tr}
    end
end

RunService.Heartbeat:Connect(function()
    if not _GGAlive() or not State.TrailEnabled then return end
    local col=getTrailCol()
    for _,t in pairs(activeTrails) do pcall(function() t.tr.Color=col end) end
end)
end -- do trail

