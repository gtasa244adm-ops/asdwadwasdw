local function KeyName(kc) local s=tostring(kc) return s:match("KeyCode%.(.+)") or tostring(kc) end
local function ComboStr(keys) local p={} for _,k in ipairs(keys) do table.insert(p,KeyName(k)) end return table.concat(p,"+") end

local kbHeld={}; local kbCombo={}; local kbConfirmTimer=nil; local _kbCallback=nil

local function CloseKBCapture()
    MS.kbOpen=false; KBOverlay.Visible=false; KBFrame.Visible=false
    kbHeld={}; kbCombo={}
    if kbConfirmTimer then task.cancel(kbConfirmTimer) kbConfirmTimer=nil end
    _kbCallback=nil
end

local function ConfirmKBCapture()
    if #kbCombo==0 then CloseKBCapture() return end
    local combo,str={},ComboStr(kbCombo)
    for _,k in ipairs(kbCombo) do table.insert(combo,k) end
    if _kbCallback then _kbCallback(combo,str) end
    CloseKBCapture()
end

local function OpenKBCapture(callback)
    if MS.inputOpen then return end
    MS.kbOpen=true; _kbCallback=callback; kbHeld={}; kbCombo={}
    KBDisplay.Text="—"; KBInstr.Text="Pressione a tecla ou combinação..."; KBInstr.TextColor3=P.TxtDim
    KBOverlay.Visible=true; KBFrame.Visible=true
    KBFrame.Size=UDim2.new(0,IsMobile and 350 or 290,0,6); KBFrame.BackgroundTransparency=1
    Tw(KBFrame,{Size=UDim2.new(0,IsMobile and 350 or 290,0,IsMobile and 172 or 142),BackgroundTransparency=0},0.16,Enum.EasingStyle.Back)
end

local kbBlack={[Enum.KeyCode.Unknown]=true;[Enum.KeyCode.Return]=true;[Enum.KeyCode.KeypadEnter]=true;}

UserInputService.InputBegan:Connect(function(inp,gpe)
    if not MS.kbOpen then return end
    if inp.KeyCode==Enum.KeyCode.Backspace or inp.KeyCode==Enum.KeyCode.Escape then CloseKBCapture() return end
    if kbBlack[inp.KeyCode] then return end
    if inp.UserInputType~=Enum.UserInputType.Keyboard then return end
    if kbConfirmTimer then task.cancel(kbConfirmTimer) kbConfirmTimer=nil end
    kbHeld[inp.KeyCode]=true; kbCombo={}
    for k in pairs(kbHeld) do table.insert(kbCombo,k) end
    KBDisplay.Text=ComboStr(kbCombo); KBInstr.Text="Solte para confirmar..."; KBInstr.TextColor3=P.Confirm
end)
UserInputService.InputEnded:Connect(function(inp)
    if not MS.kbOpen then return end
    if inp.UserInputType~=Enum.UserInputType.Keyboard then return end
    kbHeld[inp.KeyCode]=nil
    local anyHeld=false; for _ in pairs(kbHeld) do anyHeld=true break end
    if not anyHeld and #kbCombo>0 then
        KBInstr.Text="✓  Confirmado!"; KBInstr.TextColor3=P.Confirm
        kbConfirmTimer=task.delay(0.40,function() kbConfirmTimer=nil ConfirmKBCapture() end)
    end
end)
KBOverlay.InputBegan:Connect(function(inp)
    if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
        CloseKBCapture() end
end)


