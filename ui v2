-- ── Recalc ──
local function Recalc()
    if not MS.cur then return end
    local items=MS.cur.items; local y=0
    for i=1,DIM.MaxR do
        local idx=i+MS.scroll; local it=items[idx]
        local h=(it and it.tipo=="slider") and DIM.SlH or DIM.RowH
        Rows[i].r.Position=UDim2.new(0,0,0,y); Rows[i].r.Size=UDim2.new(1,0,0,h)
        if it then y=y+h end
    end
    if y==0 then y=DIM.RowH end
    UI.IList.Size=UDim2.new(1,0,0,y); UI.NavBar.Size=UDim2.new(1,0,0,DIM.NavH)
    UI.NavBar.Position=UDim2.new(0,0,0,DIM.HdrH+y)
    local total=DIM.HdrH+y+DIM.NavH
    Panel.Size=UDim2.new(0,DIM.W,0,total); Panel.Position=UDim2.new(0,Panel.Position.X.Offset,DIM.PY,-(total/2))
end

local function SliderPct(val)
    if val==0 then return 0.5 end
    if val>0 then return 0.5+0.5*(math.log(math.abs(val)+1)/math.log(10001))
    else          return 0.5-0.5*(math.log(math.abs(val)+1)/math.log(10001)) end
end

-- ── Render ──
function Render()
    if not MS.cur then return end
    local items=MS.cur.items
    UI.TitleL.Text=MS.cur.title
    UI.SubL.Text=#MS.stack>0 and ("◄  "..MS.stack[#MS.stack].title) or (LocalPlayer.Name.."  ·  GG v10")
    UI.CntL.Text=MS.idx.."/"..#items
    for i=1,DIM.MaxR do
        local idx=i+MS.scroll; local it=items[idx]; local R=Rows[i]
        if it then
            R.r.Visible=true; local sel=(idx==MS.idx)
            if sel then R.r.BackgroundColor3=RGBC
            elseif it.tipo=="display" then R.r.BackgroundColor3=Color3.fromRGB(9,9,14)
            else R.r.BackgroundColor3=(i%2==0) and P.Row or P.RowAlt end
            R.lb.Visible=sel and it.tipo~="display"; R.lbg.Visible=sel and it.tipo~="display"
            R.lbl.Text=it.label
            R.lbl.TextColor3=sel and P.SelTxt or (it.tipo=="display" and P.DispTxt or P.Txt)
            R.lbl.Font=sel and Enum.Font.GothamBold or Enum.Font.GothamSemibold
            R.lbl.TextSize=(it.tipo=="display") and (IsMobile and 12 or 10) or (IsMobile and 15 or 12)
            R.lbl.Size=(it.tipo=="slider") and UDim2.new(1,-110,0.56,0) or UDim2.new(1,-110,1,0)
            if it.tipo=="toggle" then
                local bd=KeyBindMap and KeyBindMap[it]
                local bstr=bd and (" 🔑"..bd.str) or ""
                R.rgt.Text=(it.enabled and "● ON" or "● OFF")..bstr
                R.rgt.TextColor3=sel and P.SelTxt or (it.enabled and P.TglOn or P.TglOff)
                R.sbg.Visible=false
            elseif it.tipo=="submenu" then
                R.rgt.Text="▶▶"; R.rgt.TextColor3=sel and P.SelTxt or RGBC; R.sbg.Visible=false
            elseif it.tipo=="slider" then
                local dv=(it.val==math.floor(it.val)) and tostring(math.floor(it.val)) or string.format("%.2f",it.val)
                R.rgt.Text=dv; R.rgt.TextColor3=sel and P.SelTxt or RGBC; R.sbg.Visible=true
                local pct=SliderPct(it.val)
                R.sfil.Size=UDim2.new(math.clamp(pct,0,1),0,1,0)
                R.sbg.BackgroundColor3=sel and Color3.fromRGB(0,0,0) or P.SlBg
                R.sfil.BackgroundColor3=sel and P.White or RGBC; R.sdot.BackgroundColor3=sel and P.White or RGBC
                R.sdot.Position=UDim2.new(math.clamp(pct,0,1),0,0.5,0)
            elseif it.tipo=="action" or it.isText then
                local bd=KeyBindMap and KeyBindMap[it]
                local bstr=bd and ("🔑"..bd.str) or "[ OK ]"
                local val=it.isText and ((it.textVal or ""):sub(1,10)..(((it.textVal or ""):len()>10) and ".." or "")) or bstr
                R.rgt.Text=val; R.rgt.TextColor3=sel and P.SelTxt or P.TxtDim; R.sbg.Visible=false
            else R.rgt.Text="" R.sbg.Visible=false end
        else R.r.Visible=false R.sbg.Visible=false end
    end
end
