--[[

  TEMPLATE:

      AddItem(mMisc, "display", "── Nome da Seção ──")
      AddItem(mMisc, "action", "▶ Nome do Botão", function()
          local ok, err = pcall(function()

              -- ══════════════════════════════
              -- COLE O CÓDIGO DO SCRIPT AQUI
              -- ══════════════════════════════
              local Players = game:GetService("Players")
