local function SaveSettings()
    pcall(function()
        local data = {}
        -- Salva todos os States
        for _, k in ipairs(_SaveStateKeys) do
            if State[k] ~= nil then data[k] = State[k] end
        end
        -- Salva configurações gerais
        data["_Key"]      = CFG.OpenKeyStr
        data["_Side"]     = CFG.MenuSide
        data["_AutoSave"] = AutoSaveEnabled
        data["_AutoLoad"] = AutoLoadEnabled
        local ok, json = pcall(function() return _Http:JSONEncode(data) end)
        if not ok or not json then return end
        -- Tenta writefile (executor) primeiro — persistente entre sessões
        local wrote = false
        pcall(function()
            if writefile then
                writefile(GG_SAVE_FILE, json)
                wrote = true
            end
        end)
        -- Fallback: SetAttribute (persiste só na sessão atual)
        if not wrote then
            pcall(function() LocalPlayer:SetAttribute("GGSave_v11", json) end)
        end
    end)
end

local function LoadSettings()
    local loaded = false
    -- Tenta readfile (executor) primeiro
    pcall(function()
        if readfile and isfile and isfile(GG_SAVE_FILE) then
            local raw = readfile(GG_SAVE_FILE)
            if raw and raw ~= "" then
                local ok, data = pcall(function() return _Http:JSONDecode(raw) end)
                if ok and data then
                    for k, v in pairs(data) do
                        if k:sub(1,1) ~= "_" and State[k] ~= nil then
                            State[k] = v
                        end
                    end
                    if data["_Key"]      then CFG.OpenKeyStr = data["_Key"] end
                    if data["_Side"]     then CFG.MenuSide   = data["_Side"] end
                    if data["_AutoSave"] ~= nil then AutoSaveEnabled = data["_AutoSave"] end
                    if data["_AutoLoad"] ~= nil then AutoLoadEnabled = data["_AutoLoad"] end
                    loaded = true
                end
            end
        end
    end)
    -- Fallback: SetAttribute
    if not loaded then
        pcall(function()
            local raw = LocalPlayer:GetAttribute("GGSave_v11")
            if not raw or raw == "" then return end
            local ok, data = pcall(function() return _Http:JSONDecode(raw) end)
            if not ok or not data then return end
            for k, v in pairs(data) do
                if k:sub(1,1) ~= "_" and State[k] ~= nil then
                    State[k] = v
                end
            end
            if data["_Key"]      then CFG.OpenKeyStr = data["_Key"] end
            if data["_Side"]     then CFG.MenuSide   = data["_Side"] end
            if data["_AutoSave"] ~= nil then AutoSaveEnabled = data["_AutoSave"] end
            if data["_AutoLoad"] ~= nil then AutoLoadEnabled = data["_AutoLoad"] end
        end)
    end
end

local function DeleteSave()
    pcall(function()
        if delfile and isfile and isfile(GG_SAVE_FILE) then
            delfile(GG_SAVE_FILE)
        end
    end)
    pcall(function() LocalPlayer:SetAttribute("GGSave_v11", nil) end)
    pcall(function() LocalPlayer:SetAttribute("GGSave_AutoSave", nil) end)
end

-- AUTO-LOAD ao iniciar
if AutoLoadEnabled then LoadSettings() end
-- AUTO-SAVE a cada 8 segundos se ligado
task.spawn(function() while true do task.wait(8) if AutoSaveEnabled then SaveSettings() end end end)


