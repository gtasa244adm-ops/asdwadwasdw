-- CopyOutfit, GetInventory, GetScriptList, ListAvailableTools,
-- StartSpectate, StopSpectate, SetupTeleportToPlayer, FlingPlayer
-- já foram definidos acima no bloco original do script

local function ExecButtonAction(key)
    if key=="_CopyPos" then
        local hrp=GetHRP(LocalPlayer) if hrp then
            local p=hrp.Position
            local s=string.format("Vector3.new(%.2f, %.2f, %.2f)",p.X,p.Y,p.Z)
            pcall(function() setclipboard(s) end) Notify("Posição",s,4)
        end
    elseif key=="_Fling" then
        local p=GetSelectedPlayer() if p then FlingPlayer(p.Name) Notify("Fling","Fling em "..p.Name,2)
        else Notify("Others","Nenhum player",2) end
    elseif key=="_Spectate" then
        if SpectateActive then StopSpectate() SpectateActive=false Notify("Spectate","Parado",2)
        else local p=GetSelectedPlayer() if p then StartSpectate(p.Name) SpectateActive=true Notify("Spectate","Vendo "..p.Name,2) end end
    elseif key=="_TeleportLoop" then
        if TpLoopActive then
            State.TeleportToPlayer=false if Conns.TeleportToPlayer then Conns.TeleportToPlayer:Disconnect() end
            TpLoopActive=false Notify("Teleport","Parado",2)
        else
            local p=GetSelectedPlayer() if p then
                State.TeleportToPlayer=true State.TeleportTarget=p.Name SetupTeleportToPlayer()
                TpLoopActive=true Notify("Teleport Loop",p.Name,2) end
        end
    elseif key=="_CopyOutfit" then local p=GetSelectedPlayer() if p then CopyOutfit(p.Name) end
    elseif key=="_ViewInv" then
        local p=GetSelectedPlayer() if p then
            local inv=GetInventory(p.Name)
            if #inv==0 then Notify("Inventário",p.Name.." sem itens",3)
            else Notify("Inventário - "..p.Name,table.concat(inv,", "):sub(1,200),6) end
        end
    elseif key=="_ListScripts" then
        local list=GetScriptList() Notify("Scripts ("..#list..")",table.concat(list," | "):sub(1,300),8)
    elseif key=="_ListTools" then
        local list=ListAvailableTools()
        if #list==0 then Notify("Tools","Nenhuma tool encontrada",3)
        else Notify("Tools ("..#list..")",table.concat(list,", "):sub(1,300),8) end
    elseif key=="_GravZero" then Workspace.Gravity=0 Notify("World","Gravidade = 0",2)
    elseif key=="_GravNorm" then Workspace.Gravity=196.2 Notify("World","Gravidade restaurada",2)
    elseif key=="_TimeDay"  then pcall(function() Lighting.TimeOfDay="12:00:00" end) Notify("Lighting","Dia (12h)",2)
    elseif key=="_TimeNight" then pcall(function() Lighting.TimeOfDay="00:00:00" end) Notify("Lighting","Noite (0h)",2)
    elseif key=="_Freeze" then
        local p=GetAdminSelectedPlayer() if p then local hrp=GetHRP(p)
            if hrp then hrp.Anchored=true Misc.AdminFrozenPlayers[p.Name]=true Notify("Admin ❄️",p.Name.." congelado",2) end end
    elseif key=="_Unfreeze" then
        local p=GetAdminSelectedPlayer() if p then local hrp=GetHRP(p)
            if hrp then hrp.Anchored=false Misc.AdminFrozenPlayers[p.Name]=nil Notify("Admin 🔥",p.Name.." descongelado",2) end end
    elseif key=="_Kill" then
        local p=GetAdminSelectedPlayer() if p then
            -- Tenta setar health=0 (funciona em alguns jogos)
            pcall(function() local hum=GetHumanoid(p) if hum then hum.Health=0 end end)
            -- Fallback: fling ultra agressivo (causa morte por dano de queda)
            local tHRP=GetHRP(p)
            if tHRP then
                local bv=Instance.new("BodyVelocity")
                bv.Velocity=Vector3.new(math.random(-9999,9999),99999,math.random(-9999,9999))
                bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                bv.Parent=tHRP
                game:GetService("Debris"):AddItem(bv,0.08)
            end
            Notify("Admin 💀",p.Name.." kill enviado",2)
        end
    elseif key=="_KillAll" then
        for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then
            pcall(function() local hum=GetHumanoid(p) if hum then hum.Health=0 end end)
            local tHRP=GetHRP(p)
            if tHRP then
                local bv=Instance.new("BodyVelocity")
                bv.Velocity=Vector3.new(math.random(-9999,9999),99999,math.random(-9999,9999))
                bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                bv.Parent=tHRP
                game:GetService("Debris"):AddItem(bv,0.08)
            end
        end end Notify("Admin 💀","Kill All enviado",2)
    elseif key=="_AdminTP" then
        local p=GetAdminSelectedPlayer() if p then
            local myHRP=GetHRP(LocalPlayer) local tHRP=GetHRP(p)
            if myHRP and tHRP then tHRP.CFrame=myHRP.CFrame*CFrame.new(3,0,0) Notify("Admin 📍",p.Name.." puxado",2) end end
    elseif key=="_AdminTPTo" then
        local p=GetAdminSelectedPlayer() if p then
            local myHRP=GetHRP(LocalPlayer) local tHRP=GetHRP(p)
            if myHRP and tHRP then myHRP.CFrame=tHRP.CFrame*CFrame.new(3,0,0) Notify("Admin 🚀","Você foi a "..p.Name,2) end end
    elseif key=="_AdminSpeed" then
        local p=GetAdminSelectedPlayer() if p then local hum=GetHumanoid(p)
            if hum then pcall(function() hum.WalkSpeed=State.AdminSpeedValue end)
                Notify("Admin ⚡",p.Name.." speed="..State.AdminSpeedValue,2) end end
    elseif key=="_AdminSpeedReset" then
        local p=GetAdminSelectedPlayer() if p then local hum=GetHumanoid(p)
            if hum then pcall(function() hum.WalkSpeed=16 end) end Notify("Admin",p.Name.." speed resetado",2) end
    elseif key=="_Kick" then
        local p=GetAdminSelectedPlayer() if p then
            pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(
                game.PlaceId,"00000000-0000-0000-0000-000000000000",p) end)
            Notify("Admin 👢","Kick: "..p.Name,2) end
    elseif key=="_LoopKick" then
        if AdminLoopKickActive then
            AdminLoopKickActive=false if Conns.AdminLoopKick then Conns.AdminLoopKick:Disconnect() Conns.AdminLoopKick=nil end
            Notify("Admin","Loop Kick parado",2)
        else
            local p=GetAdminSelectedPlayer() if p then
                AdminLoopKickActive=true local targetName=p.Name
                Conns.AdminLoopKick=RunService.Heartbeat:Connect(function()
                    if not AdminLoopKickActive then Conns.AdminLoopKick:Disconnect() return end
                    local t=Players:FindFirstChild(targetName) if t then
                        pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(
                            game.PlaceId,"00000000-0000-0000-0000-000000000000",t) end) end
                end)
                Notify("Admin 🔄","Loop Kick: "..p.Name,2) end
        end
    elseif key=="_KickAll" then
        for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then
            pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(
                game.PlaceId,"00000000-0000-0000-0000-000000000000",p) end) end end
        Notify("Admin 🔥","Kick all enviado",2)
    end
end

