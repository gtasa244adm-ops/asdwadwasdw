-- [13] COMO USAR State — FLAGS GLOBAIS DO SCRIPT
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
--[[

  State é uma tabela que guarda todos os valores do script.
  Fica declarada no topo do arquivo (linha ~128).

  TIPOS DE VALOR:
      State.MinhaFlag   = false   → bool (toggle)
      State.MeuValor    = 50      → número (slider)
      State.MeuTexto    = "GG"    → string (texto)

  COMO ADICIONAR UMA FLAG NOVA:
  → Procura: local State = {
  → Dentro da tabela, adiciona:
      MinhaFlag  = false,
      MeuValor   = 50,

  COMO LER DENTRO DE UM LOOP (RunService):
      RunService.Heartbeat:Connect(function()
          if not State.MinhaFlag then return end
          -- só roda quando MinhaFlag for true
      end)

  COMO REAPLICAR NO RESPAWN (CharacterAdded):
      LocalPlayer.CharacterAdded:Connect(function(char)
          task.wait(1)
          if State.MinhaFlag then
              -- reaplica feature depois de respawnar
          end
      end)

]]

