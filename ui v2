-- ── Wall Check: retorna true se NÃO tem parede entre câmera e posição ──
local function WallCheckClear(pos, character)
    local origin = Camera.CFrame.Position
    local dir    = (pos - origin)
    local params = RaycastParams.new()
    -- Remove Terrain do exclude: paredes de terreno DEVEM bloquear
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude

    local result = Workspace:Raycast(origin, dir.Unit * dir.Magnitude, params)
    -- Livre: ray não bateu em nada, ou bateu direto no personagem do alvo
    if not result then return true end
    return character ~= nil and result.Instance:IsDescendantOf(character)
end

-- ── Auto Wall: verifica se o projétil pode penetrar ──
local function AutoWallCheck(pos, character)
    local origin = Camera.CFrame.Position
    local dir    = (pos - origin)
    local params = RaycastParams.new()
    -- Remove Terrain do exclude: paredes de terreno DEVEM bloquear
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude

    local result = Workspace:Raycast(origin, dir.Unit * dir.Magnitude, params)
    if not result then return true end
    -- Acertou direto no alvo: sem parede
    if character and result.Instance:IsDescendantOf(character) then return true end
    -- Só penetra partes FINAS (< 1.5 studs) e não-Terrain
    -- Terrain nunca é penetrável
    if result.Instance:IsA("BasePart") then
        local sz = result.Instance.Size
        return math.min(sz.X, sz.Y, sz.Z) < 1.5
    end
    return false
end

-- ── Head/Body Swap: retorna o melhor osso disponível ──
local function GetBestBone(player)
    if not State.HeadBodySwap then
        return GetBonePosition(player, State.AimbotBone)
    end
    local c = GetCharacter(player)
    if not c then return nil end
    -- Tenta Head primeiro
    local head = c:FindFirstChild("Head")
    if head and WallCheckClear(head.Position, c) then
        return head.Position
    end
    -- Fallback para UpperTorso/HumanoidRootPart
    local torso = c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or c:FindFirstChild("HumanoidRootPart")
    if torso then return torso.Position end
    return nil
end

-- ── Aim Prediction avançada (projétil + gravidade) ──
local function GetPredictedPosition(player, bonePos)
    local tHRP = GetHRP(player)
    if not tHRP then return bonePos end

    local vel = tHRP.AssemblyLinearVelocity
    local dist = (Camera.CFrame.Position - bonePos).Magnitude

    if State.AimPredictionAdv then
        -- Velocidade do projétil: slider 1-100 → 100-10000 studs/s
        local projSpeed = math.clamp(State.AimProjSpeed / 100 * 10000, 100, 10000)
        local travelTime = dist / projSpeed
        -- Considera gravidade (Roblox = 196.2 studs/s²)
        local gravity = Vector3.new(0, -196.2, 0)
        local gravityOffset = 0.5 * gravity * (travelTime * travelTime)
        return bonePos + vel * travelTime - gravityOffset
    else
        -- Predição simples por velocidade
        local travelTime = dist / 1000
        return bonePos + vel * travelTime
    end
end

