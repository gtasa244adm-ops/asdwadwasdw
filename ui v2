local FlyMobileDir = {up=false,down=false,left=false,right=false,up_y=false,down_y=false}

local function SetupFly()
    if Conns.FlyBV then pcall(function() Conns.FlyBV:Destroy() end) Conns.FlyBV=nil end
    if Conns.FlyBG then pcall(function() Conns.FlyBG:Destroy() end) Conns.FlyBG=nil end
    if Conns.Fly then Conns.Fly:Disconnect() Conns.Fly=nil end
    if not State.Fly then
        local hum=GetHumanoid(LocalPlayer) if hum then hum.PlatformStand=false end return
    end
    local hrp=GetHRP(LocalPlayer) if not hrp then return end
    local hum=GetHumanoid(LocalPlayer) if hum then hum.PlatformStand=true end
    Conns.FlyBV=Instance.new("BodyVelocity")
    Conns.FlyBV.Velocity=Vector3.new(0,0,0) Conns.FlyBV.MaxForce=Vector3.new(1e9,1e9,1e9) Conns.FlyBV.Parent=hrp
    Conns.FlyBG=Instance.new("BodyGyro")
    Conns.FlyBG.MaxTorque=Vector3.new(1e9,1e9,1e9) Conns.FlyBG.D=100 Conns.FlyBG.P=5000 Conns.FlyBG.Parent=hrp
    Conns.Fly=RunService.Heartbeat:Connect(function()
        if not State.Fly then SetupFly() return end
        local hrp2=GetHRP(LocalPlayer) if not hrp2 or not Conns.FlyBV or not Conns.FlyBV.Parent then return end
        local spd=math.clamp(State.FlySpeed,5,300) local vel=Vector3.new(0,0,0) local cf=Camera.CFrame
        if not _G.GGBlock.blocked then
            if UserInputService:IsKeyDown(Enum.KeyCode.W) or FlyMobileDir.up   then vel=vel+cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) or FlyMobileDir.down  then vel=vel-cf.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) or FlyMobileDir.left  then vel=vel-cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) or FlyMobileDir.right then vel=vel+cf.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or FlyMobileDir.up_y  then vel=vel+Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or FlyMobileDir.down_y then vel=vel-Vector3.new(0,1,0) end
        else
            if FlyMobileDir.up    then vel=vel+cf.LookVector end
            if FlyMobileDir.down  then vel=vel-cf.LookVector end
            if FlyMobileDir.left  then vel=vel-cf.RightVector end
            if FlyMobileDir.right then vel=vel+cf.RightVector end
        end
        Conns.FlyBV.Velocity=vel.Magnitude>0 and vel.Unit*spd or Vector3.new(0,0,0)
        Conns.FlyBG.CFrame=cf
    end)
end

