local function OpenMenu()
    if MS.open then return end
    MS.open=true; Panel.Visible=true; UIWalkMode=false
    if MS.root and not MS.cur then
        MS.cur=MS.root; MS.idx=1; MS.scroll=0
        if MS.cur.items[1] and MS.cur.items[1].tipo=="display" then SkipDisp(1) end
    end
    local offX=DIM.OpenX
    pcall(FixScroll); pcall(Recalc); pcall(Render)
    local h=Panel.Size.Y.Offset or 0
    if h<80 then h=DIM.HdrH+(DIM.MaxR*DIM.RowH)+DIM.NavH end
    Panel.Position=UDim2.new(0,-(DIM.W+60),DIM.PY,-(h/2))
    -- Restaura posição salva do painel (só na primeira abertura)
    if _G._GG_SavedPanel and not _G._GG_PanelRestored then
        _G._GG_PanelRestored = true
        local px = _G._GG_SavedPanel.x
        _G._GG_SavedPanel = nil
        Tw(Panel,{Position=UDim2.new(0,px,DIM.PY,-(h/2))},0.24,Enum.EasingStyle.Quint)
    else
        Tw(Panel,{Position=UDim2.new(0,offX,DIM.PY,-(h/2))},0.24,Enum.EasingStyle.Quint)
    end
    GGBtn.Text="▼ GG"
    if GGDPad    then GGDPad.Visible=true end
    if GGBackBtn then GGBackBtn.Visible=true end
    -- Freeze player & show walk label
    if WalkModeLabel then
        WalkModeLabel.Visible=true
        WalkModeLabel.Text="🔒 UI Mode  [Tab]"
        WalkModeLabel.TextColor3=Color3.fromRGB(255,180,50)
    end
