        end
    else
        _G._GG_NPCCache = nil
        for k, v in pairs(NPCObjects) do
            if v.Highlight then v.Highlight:Destroy() end
            if v.Billboard then v.Billboard:Destroy() end
            NPCObjects[k] = nil
        end
    end

    -- Spawn Points ESP (só roda quando ativado/desativado)
    if State.ESP_SpawnPoints and not _G._GG_SpawnCached then
        _G._GG_SpawnCached = true
        for _, v in ipairs(Workspace:GetDescendants()) do
