    infoLabel.Size = UDim2.new(1, 0, 0, 80)
    infoLabel.Position = UDim2.new(0, 0, 0, 18)
    infoLabel.BackgroundTransparency = 1
    infoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    infoLabel.TextSize = 12
    infoLabel.Font = Enum.Font.Gotham
    infoLabel.Text = ""
    infoLabel.TextYAlignment = Enum.TextYAlignment.Top
    infoLabel.TextStrokeTransparency = 0.5
    infoLabel.Parent = billboard
    obj.InfoLabel = infoLabel

    obj.Billboard = billboard

    -- 2D box (Drawing if available)
    if Drawing then
        local box = Drawing.new("Square")
        box.Visible = false
        box.Color = Color3.fromRGB(255, 0, 100)
        box.Thickness = 1.5
        box.Filled = false
        obj.Box2D = box
    end

    -- Health bar (Drawing)
    if Drawing then
        local hpBg = Drawing.new("Square")
        hpBg.Visible = false
        hpBg.Color = Color3.fromRGB(0, 0, 0)
        hpBg.Thickness = 1
        hpBg.Filled = true
        obj.HPBg = hpBg

        local hpBar = Drawing.new("Square")
        hpBar.Visible = false
        hpBar.Color = Color3.fromRGB(0, 255, 100)
        hpBar.Thickness = 1
        hpBar.Filled = true
        obj.HPBar = hpBar

        -- Line from bottom of screen to player
        local line = Drawing.new("Line")
        line.Visible = false
        line.Color = Color3.fromRGB(255, 255, 0)
        line.Thickness = 1
        obj.Line = line
    end

    -- Skeleton lines (Drawing)
    if Drawing then
        -- R15 bone connections: {from, to}
        local skelConns = {
            {"Head","UpperTorso"},
            {"UpperTorso","LowerTorso"},
            {"UpperTorso","LeftUpperArm"},
            {"LeftUpperArm","LeftLowerArm"},
            {"LeftLowerArm","LeftHand"},
            {"UpperTorso","RightUpperArm"},
            {"RightUpperArm","RightLowerArm"},
            {"RightLowerArm","RightHand"},
            {"LowerTorso","LeftUpperLeg"},
            {"LeftUpperLeg","LeftLowerLeg"},
            {"LeftLowerLeg","LeftFoot"},
            {"LowerTorso","RightUpperLeg"},
            {"RightUpperLeg","RightLowerLeg"},
            {"RightLowerLeg","RightFoot"},
            -- R6 fallbacks
            {"Head","Torso"},
            {"Torso","Left Arm"},
            {"Torso","Right Arm"},
            {"Torso","Left Leg"},
            {"Torso","Right Leg"},
        }
        local skelLines = {}
        for i = 1, #skelConns do
            local l = Drawing.new("Line")
            l.Visible = false
            l.Color = Color3.fromRGB(0, 255, 200)
            l.Thickness = 1.5
            skelLines[i] = {line=l, from=skelConns[i][1], to=skelConns[i][2]}
        end
        obj.SkelLines = skelLines
    end

    ESPObjects[player] = obj
end

local function RemoveESPForPlayer(player)
    local obj = ESPObjects[player]
    if not obj then return end
    if obj.Highlight then obj.Highlight:Destroy() end
    if obj.Billboard then obj.Billboard:Destroy() end
    if obj.Box2D then obj.Box2D:Remove() end
    if obj.HPBg then obj.HPBg:Remove() end
    if obj.HPBar then obj.HPBar:Remove() end
    if obj.Line then obj.Line:Remove() end
    if obj.SkelLines then
        for _, s in ipairs(obj.SkelLines) do s.line:Remove() end
    end
    ESPObjects[player] = nil
end

local function UpdateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        CreateESPForPlayer(player)
    end
    -- Remove for left players
    for player in pairs(ESPObjects) do
        if not player.Parent then
            RemoveESPForPlayer(player)
        end
    end

    for player, obj in pairs(ESPObjects) do
        local hrp = GetHRP(player)
        local hum = GetHumanoid(player)
        if not hrp or not hum then
            obj.Billboard.Enabled = false
            obj.Highlight.Adornee = nil
            if obj.Box2D then obj.Box2D.Visible = false end
            if obj.HPBar then obj.HPBar.Visible = false end
            if obj.HPBg then obj.HPBg.Visible = false end
            if obj.Line then obj.Line.Visible = false end
            continue
        end

        local anyESPOn = State.ESP_Names or State.ESP_Distance or State.ESP_Health
            or State.ESP_Tool or State.ESP_Team or State.ESP_Speed
            or State.ESP_Ping or State.ESP_Status

        -- Team / enemy filter
        local shouldShow = true
        if State.ESP_EnemyOnly and not IsEnemy(player) then shouldShow = false end
        if State.ESP_AllyOnly and IsEnemy(player) then shouldShow = false end

        -- Highlight (3D box) — pcall evita "trying to set locked parent"
        pcall(function()
            obj.Highlight.Adornee = (State.ESP_Box3D and shouldShow) and player.Character or nil
            if State.ESP_Box3D and shouldShow then
                local isVis = IsVisible(player)
                if State.ESP_WallColor then
                    obj.Highlight.FillColor = isVis and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
                    obj.Highlight.OutlineColor = isVis and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
                elseif State.ESP_Team then
                    local tc = player.TeamColor
                    obj.Highlight.FillColor = tc and tc.Color or Color3.fromRGB(200, 200, 200)
                    obj.Highlight.OutlineColor = tc and tc.Color or Color3.fromRGB(200, 200, 200)
                else
                    obj.Highlight.FillColor = Color3.fromRGB(100, 60, 220)
                    obj.Highlight.OutlineColor = Color3.fromRGB(130, 80, 255)
                end
            end
        end)

        -- Billboard text — pcall evita "trying to set locked parent"
        pcall(function()
            obj.Billboard.Adornee = hrp
            obj.Billboard.Enabled = anyESPOn and shouldShow
        end)

        if anyESPOn and shouldShow then
            -- Name
            local nameStr = State.ESP_Names and player.Name or ""
            obj.NameLabel.Text = nameStr
            if State.ESP_Team then
                local tc = player.TeamColor
                obj.NameLabel.TextColor3 = tc and tc.Color or Color3.fromRGB(255, 255, 255)
            else
                obj.NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            end

            -- Info lines
            local lines = {}
            if State.ESP_Distance then
                local d = GetDistance(player)
                if State.ESP_DistanceMeter then
                    table.insert(lines, "📍 " .. d .. " st / " .. math.floor(d * 0.28) .. " m")
                else
                    table.insert(lines, "📍 " .. d .. " studs")
                end
            end
            if State.ESP_Health then
                local hp = math.floor(hum.Health)
                local maxHp = math.floor(hum.MaxHealth)
                table.insert(lines, "❤ " .. hp .. "/" .. maxHp)
            end
            if State.ESP_Tool then
                -- Mostra TODOS os itens do backpack + equipado
                local items = {}
                local bp = player:FindFirstChild("Backpack")
                if bp then
                    for _, v in ipairs(bp:GetChildren()) do
                        if v:IsA("Tool") then table.insert(items, v.Name) end
                    end
                end
                if player.Character then
                    for _, v in ipairs(player.Character:GetChildren()) do
                        if v:IsA("Tool") then table.insert(items, "["..v.Name.."]") end
                    end
                end
                table.insert(lines, "🎒 " .. (#items > 0 and table.concat(items, ", ") or "Empty"))
            end
            if State.ESP_Speed then
                table.insert(lines, "⚡ " .. math.floor(hum.WalkSpeed) .. " ws")
            end
            if State.ESP_Ping then
                table.insert(lines, "📶 ~" .. math.floor(math.random(20, 120)) .. "ms")
            end
            if State.ESP_Status then
                local status = hum.MoveDirection.Magnitude > 0.1 and "🏃 Moving" or "🧍 Idle"
                if hum.Health <= 0 then status = "💀 Dead" end
                table.insert(lines, status)
            end
            if State.ESP_Visible then
                local vis = IsVisible(player)
                table.insert(lines, vis and "👁 Visible" or "🚫 Hidden")
            end
            obj.InfoLabel.Text = table.concat(lines, "\n")
        end

        -- 2D Box
        local screenPos, onScreen, depth = WorldToScreen(hrp.Position)
        if State.ESP_Box2D and shouldShow and onScreen and obj.Box2D then
            local h = 2000 / depth
            local w = h * 0.6
            obj.Box2D.Visible = true
            obj.Box2D.Size = Vector2.new(w, h)
            obj.Box2D.Position = Vector2.new(screenPos.X - w/2, screenPos.Y - h/2)
            if State.ESP_Team then
                local tc = player.TeamColor
