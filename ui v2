local function WorldToScreen(pos)
    local screenPos, onScreen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen, screenPos.Z
end

local function GetCharacter(player)
    return player and player.Character
end

local function GetHRP(player)
    local c = GetCharacter(player)
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid(player)
    local c = GetCharacter(player)
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function IsAlive(player)
    local h = GetHumanoid(player)
    return h and h.Health > 0
end

local function GetDistance(player)
    local hrp = GetHRP(player)
    local lhrp = GetHRP(LocalPlayer)
    if hrp and lhrp then
        return math.floor((hrp.Position - lhrp.Position).Magnitude)
    end
    return 0
end

local function IsEnemy(player)
    return player.Team ~= LocalPlayer.Team
end

local function IsVisible(player)
    local char = GetCharacter(player)
    if not char then return false end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    local head = char:FindFirstChild("Head")
    if not hrp then return false end

    local params = RaycastParams.new()
    -- SÓ exclui o personagem local — Terrain e paredes precisam bloquear
    params.FilterDescendantsInstances = {LocalPlayer.Character}
    params.FilterType = Enum.RaycastFilterType.Exclude

    local origin = Camera.CFrame.Position
    -- Checa HRP e Head: se qualquer ponto estiver visível, considera visível
    local checkPoints = {hrp.Position}
    if head then table.insert(checkPoints, head.Position) end

    for _, pos in ipairs(checkPoints) do
        local dir    = (pos - origin)
        local result = Workspace:Raycast(origin, dir.Unit * math.min(dir.Magnitude, 2000), params)
        -- Sem obstrução OU o primeiro hit já é o próprio personagem do alvo
        if not result or result.Instance:IsDescendantOf(char) then
            return true
        end
    end
    return false
end

local function GetPlayerList(filtered)
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if filtered == "Enemies" and not IsEnemy(p) then continue end
            if filtered == "Allies" and IsEnemy(p) then continue end
            table.insert(list, p)
        end
    end
    return list
end

local function GetBonePosition(player, bone)
    local c = GetCharacter(player)
    if not c then return nil end
    local part = c:FindFirstChild(bone) or c:FindFirstChild("Head") or GetHRP(player)
    return part and part.Position
end

