                    hl.Parent = PlayerGui
                end
            end
        end
    elseif not State.ESP_SpawnPoints and _G._GG_SpawnCached then
        _G._GG_SpawnCached = nil
        for _, v in ipairs(PlayerGui:GetChildren()) do
            if v.Name == "_GGSpawnHL" then v:Destroy() end
        end
    end
end

