-- Loop de gruda: Heartbeat mantém posição
RunService.Heartbeat:Connect(function()
    if not _G.GGBang.active then return end
    local p = _G.GGBang.target
    if not p or not p.Parent then _G.GGBang.Off() return end
    local myHRP = GetHRP(LocalPlayer)
    if not myHRP then return end
    local mode = _G.GGBang.mode
    if mode == "atras" or mode == "normal" then
        local tHRP = GetHRP(p)
        if not tHRP then return end
        local dist = mode=="atras" and 1.2 or 1.0
        local cf = tHRP.CFrame * CFrame.new(0,0,dist)
        pcall(function() myHRP.CFrame=CFrame.new(cf.Position,tHRP.Position) end)
    elseif mode == "head" then
        if not p.Character then return end
        local head = p.Character:FindFirstChild("Head")
        if not head then return end
        local frontPos = head.CFrame * CFrame.new(0,0,-1.0)
        pcall(function() myHRP.CFrame=CFrame.new(frontPos.Position,head.Position) end)
    end
end)

