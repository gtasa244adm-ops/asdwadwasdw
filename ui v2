--   SAVE/LOAD REAL (writefile/readfile do executor)
--   Persiste entre sessões e reinícios do jogo
-- ═══════════════════════════════════════════════
local CFG = {OpenKeys={Enum.KeyCode.F2}; OpenKeyStr="F2"; MenuSide="Esquerda"; RGBSpeed=3;}
local SAVE_FILE = "GGScript_v12_full.json"

-- Converte string "F2" → Enum.KeyCode.F2
local function StrToKeyCode(s)
    local ok, kc = pcall(function() return Enum.KeyCode[s] end)
    if ok and kc then return kc end
    return Enum.KeyCode.F2
end

local function SaveSettings()
    pcall(function()
        local data = {}
        -- 1. Salva todo o State
        for k, v in pairs(State) do
            local t = type(v)
            if t=="string" or t=="number" or t=="boolean" then data[k]=v end
        end
        -- 2. Config do menu
        data["_AutoSave"]   = AutoSaveEnabled
        data["_OpenKeyStr"] = CFG.OpenKeyStr
        data["_MenuSide"]   = CFG.MenuSide
        data["_RGBSpeed"]   = RGB_SPD
        -- 3. Posição do botão GG (salva X e Y offsets)
        pcall(function()
            data["_GGBtnXS"] = GGBtn.Position.X.Scale
            data["_GGBtnX"]  = GGBtn.Position.X.Offset
            data["_GGBtnYS"] = GGBtn.Position.Y.Scale
            data["_GGBtnY"]  = GGBtn.Position.Y.Offset
        end)
        -- 4. Posição do painel
        pcall(function()
            data["_PanelX"] = Panel.Position.X.Offset
            data["_PanelY"] = Panel.Position.Y.Offset
        end)
        -- 5. KeyBinds: label → keycode string
        local binds = {}
        pcall(function()
            for item, bind in pairs(KeyBindMap) do
                if item and item.label and bind.str then
                    binds[item.label] = bind.str
                end
            end
        end)
        data["_KeyBinds"] = game:GetService("HttpService"):JSONEncode(binds)
        -- 6. OpenKeys como array de strings
        local keysArr = {}
        for _, k in ipairs(CFG.OpenKeys) do
            local s = tostring(k):match("KeyCode%.(.+)") or tostring(k)
            table.insert(keysArr, s)
        end
        data["_OpenKeysArr"] = game:GetService("HttpService"):JSONEncode(keysArr)
        local json = game:GetService("HttpService"):JSONEncode(data)
        writefile(SAVE_FILE, json)
    end)
end

local function LoadSettings()
    pcall(function()
        if not isfile(SAVE_FILE) then return end
        local json = readfile(SAVE_FILE)
        if not json or json == "" then return end
        local data = game:GetService("HttpService"):JSONDecode(json)
        if not data then return end
        -- 1. AutoSave e CFG básico
        if data["_AutoSave"]   ~= nil then AutoSaveEnabled = data["_AutoSave"] end
        if data["_OpenKeyStr"] ~= nil then CFG.OpenKeyStr  = data["_OpenKeyStr"] end
        if data["_MenuSide"]   ~= nil then CFG.MenuSide    = data["_MenuSide"] end
        if data["_RGBSpeed"]   ~= nil then RGB_SPD         = data["_RGBSpeed"] end
        -- 2. Reconstrói OpenKeys do array de strings salvo
        if data["_OpenKeysArr"] then
            local ok2, arr = pcall(function()
                return game:GetService("HttpService"):JSONDecode(data["_OpenKeysArr"])
            end)
            if ok2 and arr and #arr > 0 then
                local keys = {}
                for _, s in ipairs(arr) do
                    table.insert(keys, StrToKeyCode(s))
                end
                CFG.OpenKeys = keys
            end
        end
        -- 3. Carrega State (todos os toggles, sliders, textos)
        for k, v in pairs(data) do
            if k:sub(1,1) ~= "_" and State[k] ~= nil and type(v) == type(State[k]) then
                State[k] = v
            end
        end
        -- 4. Armazena posição do botão GG para restaurar após criação
        if data["_GGBtnX"] ~= nil then
            _G._GG_SavedBtn = {
                xs = data["_GGBtnXS"] or 0,
                x  = data["_GGBtnX"],
                ys = data["_GGBtnYS"] or 0.5,
                y  = data["_GGBtnY"]  or (IsMobile and -25 or -15)
            }
        end
        -- 5. Armazena posição do painel para restaurar ao abrir
        if data["_PanelX"] ~= nil then
            _G._GG_SavedPanel = {x = data["_PanelX"], y = data["_PanelY"] or 0}
        end
        -- 6. Armazena binds pendentes para restaurar após BuildMenus
        if data["_KeyBinds"] and data["_KeyBinds"] ~= "{}" then
            _G._GG_PendingBinds = data["_KeyBinds"]
        end
    end)
end
