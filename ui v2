                bv.Velocity=Vector3.new(math.random(-9999,9999),99999,math.random(-9999,9999))
                bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                bv.Parent=tHRP
                game:GetService("Debris"):AddItem(bv,0.08)
            end
            Notify("Admin 💀",p.Name.." kill enviado",2)
        end
    elseif key=="_KillAll" then
        for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then
            pcall(function() local hum=GetHumanoid(p) if hum then hum.Health=0 end end)
            local tHRP=GetHRP(p)
            if tHRP then
                local bv=Instance.new("BodyVelocity")
                bv.Velocity=Vector3.new(math.random(-9999,9999),99999,math.random(-9999,9999))
                bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                bv.Parent=tHRP
                game:GetService("Debris"):AddItem(bv,0.08)
            end
        end end Notify("Admin 💀","Kill All enviado",2)
    elseif key=="_AdminTP" then
        local p=GetAdminSelectedPlayer() if p then
            local myHRP=GetHRP(LocalPlayer) local tHRP=GetHRP(p)
            if myHRP and tHRP then tHRP.CFrame=myHRP.CFrame*CFrame.new(3,0,0) Notify("Admin 📍",p.Name.." puxado",2) end end
    elseif key=="_AdminTPTo" then
        local p=GetAdminSelectedPlayer() if p then
            local myHRP=GetHRP(LocalPlayer) local tHRP=GetHRP(p)
            if myHRP and tHRP then myHRP.CFrame=tHRP.CFrame*CFrame.new(3,0,0) Notify("Admin 🚀","Você foi a "..p.Name,2) end end
    elseif key=="_AdminSpeed" then
        local p=GetAdminSelectedPlayer() if p then local hum=GetHumanoid(p)
            if hum then pcall(function() hum.WalkSpeed=State.AdminSpeedValue end)
                Notify("Admin ⚡",p.Name.." speed="..State.AdminSpeedValue,2) end end
    elseif key=="_AdminSpeedReset" then
        local p=GetAdminSelectedPlayer() if p then local hum=GetHumanoid(p)
            if hum then pcall(function() hum.WalkSpeed=16 end) end Notify("Admin",p.Name.." speed resetado",2) end
    elseif key=="_Kick" then
        local p=GetAdminSelectedPlayer() if p then
            pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(
                game.PlaceId,"00000000-0000-0000-0000-000000000000",p) end)
            Notify("Admin 👢","Kick: "..p.Name,2) end
    elseif key=="_LoopKick" then
        if AdminLoopKickActive then
            AdminLoopKickActive=false if Conns.AdminLoopKick then Conns.AdminLoopKick:Disconnect() Conns.AdminLoopKick=nil end
            Notify("Admin","Loop Kick parado",2)
        else
            local p=GetAdminSelectedPlayer() if p then
                AdminLoopKickActive=true local targetName=p.Name
                Conns.AdminLoopKick=RunService.Heartbeat:Connect(function()
                    if not AdminLoopKickActive then Conns.AdminLoopKick:Disconnect() return end
                    local t=Players:FindFirstChild(targetName) if t then
                        pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(
                            game.PlaceId,"00000000-0000-0000-0000-000000000000",t) end) end
                end)
                Notify("Admin 🔄","Loop Kick: "..p.Name,2) end
        end
    elseif key=="_KickAll" then
        for _,p in ipairs(Players:GetPlayers()) do if p~=LocalPlayer then
            pcall(function() game:GetService("TeleportService"):TeleportToPlaceInstance(
                game.PlaceId,"00000000-0000-0000-0000-000000000000",p) end) end end
        Notify("Admin 🔥","Kick all enviado",2)
    end
end

