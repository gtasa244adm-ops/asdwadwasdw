      end)

  ── REJOIN ──
      AddItem(mMisc, "action", "🔄 Rejoin", function()
          game:GetService("TeleportService"):Teleport(game.PlaceId, game.Players.LocalPlayer)
      end)

  ── EXPLOSÃO NO PERSONAGEM ──
      AddItem(mMisc, "action", "💥 Explodir", function()
          local char = game.Players.LocalPlayer.Character
          if not char then return end
          local e = Instance.new("Explosion")
          e.Position = char.HumanoidRootPart.Position
          e.BlastRadius = 10
          e.BlastPressure = 1000000
          e.Parent = workspace
          Notify("💥 Boom","Explodiu!",2)
      end)

  ── LISTAR PLAYERS NO CONSOLE ──
      AddItem(mMisc, "action", "📋 Listar Players", function()
          for _, p in ipairs(game.Players:GetPlayers()) do
              print(p.Name .. " | ID: " .. p.UserId)
          end
          Notify("📋 Players","Lista no console (F9)",3)
      end)

  ── SPEED TOGGLE ──
      AddItem(mMisc, "toggle", "⚡ Speed 50", State.MySpeed, function(v)
          State.MySpeed = v
          local hum = game.Players.LocalPlayer.Character and
                      game.Players.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
          if hum then hum.WalkSpeed = v and 50 or 16 end
          Notify("⚡ Speed", v and "Velocidade 50!" or "Normal", 2)
      end)

  ── ANTI AFK ──
      AddItem(mMisc, "toggle", "🔄 Anti AFK", State.AntiAFK, function(v)
          State.AntiAFK = v
          if v then
              task.spawn(function()
                  while State.AntiAFK do
                      task.wait(60)
                      if not State.AntiAFK then break end
                      local vjs = game:GetService("VirtualInputManager")
                      pcall(function() vjs:SendKeyEvent(true, "W", false, game) end)
                      pcall(function() vjs:SendKeyEvent(false, "W", false, game) end)
                  end
              end)
              Notify("🔄 Anti AFK","Ativado!",3)
          else
              Notify("🔄 Anti AFK","Desativado!",3)
          end
      end)

  ── OLHAR PRO ALVO MAIS PRÓXIMO ──
      AddItem(mMisc, "action", "👀 Olhar pro alvo mais próximo", function()
          local myHRP = game.Players.LocalPlayer.Character and
                        game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
          if not myHRP then return end
          local closest, closestDist = nil, math.huge
          for _, p in ipairs(game.Players:GetPlayers()) do
              if p ~= game.Players.LocalPlayer and p.Character then
                  local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                  if hrp then
                      local d = (hrp.Position - myHRP.Position).Magnitude
                      if d < closestDist then closestDist = d; closest = hrp end
                  end
              end
          end
          if closest then
              myHRP.CFrame = CFrame.lookAt(myHRP.Position, closest.Position)
              Notify("👀 Look","Olhando pro alvo!",2)
          else
              Notify("👀 Look","Nenhum alvo encontrado",2)
          end
      end)

  ── SUPER PULO UMA VEZ ──
      AddItem(mMisc, "action", "🚀 Super Pulo", function()
          local char = game.Players.LocalPlayer.Character
          local hrp  = char and char:FindFirstChild("HumanoidRootPart")
          if hrp then
              hrp.Velocity = Vector3.new(0, 200, 0)
              Notify("🚀 Super Pulo","Wheee!",2)
          end
      end)

]]

