local mKBList = NewMenu("Binds Ativos","Lista de binds atuais")
local kbListItems = {}

local function RefreshKBList()
    -- Clear existing items
    mKBList.items = {}
    kbListItems = {}
    local count=0
    for item, bind in pairs(KeyBindMap) do
        count=count+1
        local capItem=item; local capBind=bind
        local disp=AddItem(mKBList,"action",item.label.." → "..bind.str,function()
            KBRemove(capItem)
            RefreshKBList()
        end)
        table.insert(kbListItems, disp)
    end
    if count==0 then
        AddItem(mKBList,"display","(Nenhum bind ativo)")
    end
    AddItem(mKBList,"display","── Clique p/ remover ──")
end
