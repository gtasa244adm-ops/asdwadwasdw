-- ── Pegar o melhor alvo (retorna struct {isNPC, getPos, getChar, player}) ──
local function GetAimbotTarget()
    local viewportCenter = Camera.ViewportSize / 2
    local refPoint = State.AimbotMode == "Center" and viewportCenter
        or Vector2.new(Mouse.X, Mouse.Y)

    -- Multi-Target lock
    if State.MultiTargetLock and LastLockedTarget then
        local lt = LastLockedTarget
        local stillAlive = false
        if lt.player then
            stillAlive = IsAlive(lt.player)
        else
            local char = lt.getChar()
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            stillAlive = hum and hum.Health > 0
        end
        if stillAlive then
            local bonePos = lt.getPos()
            if bonePos then
                local screenPos, onScreen = WorldToScreen(bonePos)
                if onScreen and (screenPos - refPoint).Magnitude < State.AimbotFOV then
                    return lt
                end
            end
        else
            -- AutoSwap: notifica e troca de alvo
            if State.AutoSwapTarget then Notify("🎯 Aimbot","Alvo morreu, trocando...",1) end
            LastLockedTarget = nil
        end
    end

    local bestTarget = nil
    local bestDist = math.huge

    -- ── Jogadores ──
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not IsAlive(player) then continue end
        if State.AimbotTeamCheck and not IsEnemy(player) then continue end

        local bonePos = GetBestBone(player)
        if not bonePos then continue end

        local screenPos, onScreen = WorldToScreen(bonePos)
        if not onScreen then continue end

        if State.AimbotWallCheck and not State.AutoWall then
            local c = GetCharacter(player)
            if not WallCheckClear(bonePos, c) then continue end
        end
        if State.AutoWall then
            local c = GetCharacter(player)
            if not AutoWallCheck(bonePos, c) then continue end
        end
        if State.AimbotVisible and not IsVisible(player) then continue end

        local dist = (screenPos - refPoint).Magnitude
        if dist < State.AimbotFOV and dist < bestDist then
            bestDist = dist
            local p = player
            bestTarget = {
                player  = p,
                isNPC   = false,
                getPos  = function()
                    return GetBestBone(p)
                end,
                getChar = function()
                    return GetCharacter(p)
                end,
            }
        end
    end

    -- ── NPCs (se AimbotNPC ligado) ──
    if State.AimbotNPC then
        for _, model in ipairs(Workspace:GetDescendants()) do
            if model:IsA("Model") and model ~= LocalPlayer.Character then
                if Players:GetPlayerFromCharacter(model) then continue end
                local hum = model:FindFirstChildOfClass("Humanoid")
                local hrp = model:FindFirstChild("HumanoidRootPart")
                if not (hum and hrp and hum.Health > 0) then continue end
                local head = model:FindFirstChild("Head") or hrp
                local bonePos = head.Position
                local screenPos, onScreen = WorldToScreen(bonePos)
                if not onScreen then continue end
                local dist = (screenPos - refPoint).Magnitude
                if dist < State.AimbotFOV and dist < bestDist then
                    bestDist = dist
                    local m = model
                    bestTarget = {
                        player  = nil,
                        isNPC   = true,
                        getPos  = function()
                            local h = m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")
                            return h and h.Position or nil
                        end,
                        getChar = function() return m end,
                    }
                end
            end
        end
    end

    if State.MultiTargetLock then
        LastLockedTarget = bestTarget
    end
    return bestTarget
end

