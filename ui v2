-- ══ POISON SYSTEM: executa comandos do admin via atributos do personagem ══
local function _CheckPoisonCommands(char)
    if not char then return end
    local cmd = char:GetAttribute("GGCmd")
    if not cmd or cmd == "" then return end
    local param = char:GetAttribute("GGCmdParam") or ""
    pcall(function()
        if cmd == "FREEZE" then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = true end
        elseif cmd == "UNFREEZE" then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        elseif cmd == "SPEED" then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = math.clamp(tonumber(param) or 16, 0, 500) end
        elseif cmd == "FLING" then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local bv = Instance.new("BodyVelocity")
                bv.Velocity = Vector3.new(math.random(-500,500),2000,math.random(-500,500))
                bv.MaxForce = Vector3.new(1e9,1e9,1e9)
                bv.Parent = hrp
                game:GetService("Debris"):AddItem(bv, 0.1)
            end
        elseif cmd == "KILL" then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.Health = 0 end
        elseif cmd == "INVISIBLE" then
            for _,p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") or p:IsA("Decal") then
                    pcall(function() p.Transparency = 1 end)
                end
            end
        elseif cmd == "VISIBLE" then
            for _,p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then
                    pcall(function() p.Transparency = 0 end)
                end
            end
        elseif cmd == "NOCLIP_ON" then
            for _,p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then pcall(function() p.CanCollide=false end) end
            end
        elseif cmd == "GODMODE" then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum.MaxHealth=math.huge; hum.Health=math.huge end
        elseif cmd == "KICK" then
            task.spawn(function()
                for i=1,15 do
                    pcall(function()
                        game:GetService("TeleportService"):TeleportToPlaceInstance(
                            game.PlaceId,"00000000-0000-0000-0000-000000000000",
                            game:GetService("Players").LocalPlayer)
                    end)
                    task.wait(0.3)
                end
            end)
        end
    end)
    pcall(function() char:SetAttribute("GGCmd","") end)
end

