-- [8] COMO USAR task.spawn() E task.wait() CORRETAMENTE
-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
--[[

  ❌ NUNCA USE wait() puro — trava o thread e dá warning
  ✅ SEMPRE USE task.wait()

  ── task.wait() ──
      task.wait(0.5)   → espera 0.5 segundo sem travar o menu

  ── task.spawn() ──  Roda código em paralelo (não trava o menu)
      task.spawn(function()
          task.wait(1)
          Notify("⏱️","1 segundo depois!",3)
      end)

  ── task.delay() ──  Roda depois de X segundos
      task.delay(2, function()
          Notify("⏱️","Rodou depois de 2s!",3)
      end)

  ── Loop que não trava ──
      task.spawn(function()
          while task.wait(0.1) do
              if not State.MinhaFlag then break end
              -- código que roda a cada 0.1s
          end
      end)

]]

